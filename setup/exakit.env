# exakit.env - every setting of the Exasol Personal Local Starter Kit, in one place.
#
# The kit reads this file on every install and every `exakit` command:
#   ~/.exasol-starter-kit/exakit.env     (EXAKIT_ENV_FILE=/path/to/file picks another)
# The installer copies this template there on the first install and never overwrites
# your copy. To change a setting, remove the "# " in front of its line and edit the value.
#
# The rules:
#   - one NAME=value per line; "#" starts a comment; quotes around a value are optional
#   - nothing is run: no $VARIABLES, no $(commands) - the value is taken as written
#   - a value already in the environment wins (e.g. on the install command line), so the
#     file holds your defaults and a command line still changes one run
#   - only EXAKIT_* names (and EXASOL_TELEMETRY_DISABLE) are read; anything else is ignored
#   - no secrets: a name with PASSWORD, API_KEY, TOKEN or SECRET in it is refused - keep
#     those in the environment or in the kit's credentials store
#   - EXAKIT_HOME cannot be set here (the file lives inside it): set it in the environment
#
# Every line below shows the kit's default. tests/env-file.sh keeps this file complete:
# a documented setting missing here, or one listed here that nothing reads, fails it.

# --- Where the kit comes from -----------------------------------------------------------
# EXAKIT_REPO=exasol-labs/exasol-personal-local-starterkit   # owner/name to install from
# EXAKIT_REF=main                       # branch or tag to install from
# EXAKIT_LOCAL_KIT=                     # a local checkout to install from instead (development)
# EXAKIT_NO_PROFILE_EDIT=0              # 1: never edit shell profiles; print the PATH line instead
# EXAKIT_DRY_RUN=0                      # 1: show the plan and the scripts, install nothing
# EXAKIT_DRY_RUN_KEEP=0                 # 1: with EXAKIT_DRY_RUN, keep the unpacked kit for reading
# EXAKIT_PREFLIGHT=0                    # 1: check this machine's requirements, install nothing

# --- Persona and data -------------------------------------------------------------------
# EXAKIT_PERSONA=                       # data-scientist, general - several with a comma (ml-engineer: disabled for now)
# EXAKIT_DATASETS=                      # datasets to load, by id: tpch,energy,weather,
#                                       #   amazon_sales,fraud_transactions (wins over EXAKIT_LOAD_SAMPLE)
# EXAKIT_LOAD_SAMPLE=                   # 0: load no data, 1: load the kit's own samples
# EXAKIT_DATASETS_MIRROR=               # a folder, file:// or https:// base URL holding the dataset archives
# EXAKIT_DATASETS_REPO=                 # owner/name whose "datasets" release holds them (default: EXAKIT_REPO)
# EXAKIT_DATA_FILE=                     # load this CSV / Parquet / JSON file (skips the data menu)
# EXAKIT_DATA_TABLE=                    # SCHEMA.TABLE for EXAKIT_DATA_FILE (default STARTER_KIT.<FILENAME>)
# EXAKIT_ON_EXISTING=                   # replace or append when that table already exists
# EXAKIT_UPLOAD_RETRIES=2               # more tries for an upload whose connection is cut
# EXAKIT_SCHEMA=STARTER_KIT             # the default target schema for your own data
# EXAKIT_DESCRIPTOR_OWNER=              # the owner an approved descriptor records (default: your OS user)

# --- AI clients (MCP) -------------------------------------------------------------------
# EXAKIT_MCP_CLIENTS=                   # by name: claude, claude_desktop, claude_code, codex, cursor,
#                                       #   copilot, gemini, opencode, continue, all or skip
# EXAKIT_SKIP_MCP=                      # 1: set up no AI client now (exakit mcp-setup later)
# EXAKIT_MCP_READONLY_SCHEMAS=STARTER_KIT   # the schema the read-only MCP connection opens on

# --- Add-ons (the marketplace) ----------------------------------------------------------
# EXAKIT_MARKETPLACE_ADDONS=            # answer the add-on offer: ids (dash-server,notebook,...), all or none
# EXAKIT_NOTEBOOK_FRONTENDS=            # jupyterlab,marimo or none
# EXAKIT_NOTEBOOK_JUPYTER=              # skip: do not install JupyterLab, install: install it without asking
# EXAKIT_NOTEBOOK_MARIMO=               # skip / install, the same for Marimo
# EXAKIT_NOTEBOOK_PORT=8888             # JupyterLab's port
# EXAKIT_MARIMO_PORT=2718               # Marimo's port
# EXAKIT_NOTEBOOK_SCHEMA=STARTER_KIT    # the schema the notebook connector opens on
# EXAKIT_DASH_SERVER_PORT=5100          # Dash Server's port
# EXAKIT_MLFLOW_PORT=5000               # the local MLflow server's port
# EXAKIT_STOP_ADDONS=1                  # 0: keep add-on services running when the database stops
# EXAKIT_UDF_LANGUAGE=python            # python or rust: the UDF language the ML Engineer sets up
# EXAKIT_UDF_ARCH=                      # x86_64 or aarch64: override the database architecture
# EXAKIT_UDF_CONTAINERS_MIRROR=         # a folder or URL holding the prebuilt UDF containers
# EXAKIT_UDF_CONTAINER_CACHE=           # where downloaded UDF containers are kept (default <EXAKIT_HOME>/cache/containers)
# EXAKIT_UDF_INSTALL_TIMEOUT=3600       # seconds to wait for a UDF container install
# EXAKIT_MODEL_TRUST=                   # 1: confirm an unproven pickle/joblib model (like exakit model put --yes)
# EXAKIT_UNINSTALL_NOTEBOOKS=           # remove: delete the notebooks folder on uninstall

# --- Notebooks and models ---------------------------------------------------------------
# EXAKIT_MODEL_ID=                      # the model the notebooks call
# EXAKIT_PROVIDER_BASE_URL=             # that model's API base URL (the key stays in the environment)
# EXAKIT_PROVIDER_HEADERS=              # JSON routing headers for the model provider
# EXAKIT_MODEL_TEMPERATURE=             # e.g. 0 for repeatable local-model answers; unset for Claude (Opus 4.7+ refuses it)

# --- Versions and updates ---------------------------------------------------------------
# EXAKIT_VERSION_POLICY=manifest        # manifest (the tested set), latest, or pinned (no network)
# EXAKIT_MCP_SIDECAR_PORT=4896         # the MCP server beside the database listens here (moved to a free port when taken)
# EXAKIT_VERSIONS_URL=                  # where the versions document is fetched from (https)
# EXAKIT_VERSIONS_TTL=86400             # seconds before that document is fetched again
# EXAKIT_NO_UPDATE_NOTICE=0             # 1: never print the update notice
# EXAKIT_NOTICE_INTERVAL=0              # seconds between two update notices (0: every command)
# EXAKIT_MANAGED_PYTHON_VERSION=3.12    # the Python the kit's own tools run on
# EXAKIT_PERSONAL_VERSION=              # one component's version, instead of the policy's:
# EXAKIT_EXAPUMP_VERSION=
# EXAKIT_MCP_VERSION=
# EXAKIT_PYEXASOL_VERSION=
# EXAKIT_NOTEBOOK_VERSION=
# EXAKIT_NOTEBOOK_JUPYTERLAB_VERSION=
# EXAKIT_NOTEBOOK_MARIMO_VERSION=
# EXAKIT_DASH_SERVER_VERSION=
# EXAKIT_DBT_EXASOL_VERSION=
# EXAKIT_EXASOL_SCHEDULER_VERSION=
# EXAKIT_EXASOL_VSCODE_VERSION=
# EXAKIT_JSON_TABLES_VERSION=
# EXAKIT_ALLOW_UNVERIFIED_EXAPUMP=0     # 1: install a binary WITHOUT checking its checksum (maintainers only)
# EXAKIT_ALLOW_UNVERIFIED_JSON_TABLES=0
# EXAKIT_ALLOW_UNVERIFIED_EXASOL_SCHEDULER=0
# EXAKIT_ALLOW_UNVERIFIED_EXASOL_VSCODE=0

# --- The database -----------------------------------------------------------------------
# EXAKIT_DB_PORT=8563                   # the database port
# EXAKIT_REUSE_DB=                      # 1: adopt an existing database (the default), 0: decline
# EXAKIT_REPLACE_DB=                    # 1: consent to replacing a stopped deployment (loses its data)
# EXAKIT_AUTOSTART_CHANGE=              # 1 or 0: pre-answer starting the database at login
# EXAKIT_CONFIRM_RUNTIME_UPDATE=        # 1: may stop the database to update its runtime
# EXAKIT_CONFIRM_RUNTIME_REPAIR=0       # 1: may repair a broken runtime without asking
# EXAKIT_AUTO_ROLLBACK=0                # 1: undo a failed install step without asking
# EXAKIT_FORCE=0                        # 1: install although a RAM or disk check failed
# EXAKIT_PERSONAL_MIN_RAM_GB=8          # the RAM the requirements check asks for
# EXAKIT_PERSONAL_MIN_DISK_GB=20        # the free disk it asks for
# EXAKIT_PERSONAL_READY_TIMEOUT=150     # seconds to wait for the database to come up
# EXAKIT_PERSONAL_REBUILD_TIMEOUT=900   # seconds to wait when a launcher update rebuilds it
# EXAKIT_PERSONAL_REAP_MIN_AGE=180      # seconds before a stray runner process counts as abandoned
# EXAKIT_PERSONAL_S3=1                  # 0: fetch the launcher from GitHub, not Exasol's S3 bucket
# EXAKIT_EXAPUMP_READY_TIMEOUT=180      # seconds to wait for exapump to connect
# EXAKIT_INSTALL_PODMAN=                # 0 (Linux, WSL): do not install Podman when it is missing
# EXAKIT_PODMAN_SELFHEAL=               # 1: consent to the one system change that fixes Podman
# EXAKIT_LEGACY_DATA=                   # migrate or skip: a database from an older, container-based kit
# EXAKIT_LEGACY_READY_TIMEOUT=120       # seconds to wait for that older container
# EXAKIT_CONTAINER_ENGINE=              # docker or podman (Linux, WSL, Windows): the engine for a NEW
#                                       #   deployment (default: Docker when it answers, else Podman)
# EXAKIT_WSL_CHECKED=0                  # 1 (Windows, Podman): `wsl --version` shows 2.7 or newer

# --- External sources (exakit connect) --------------------------------------------------
# EXAKIT_NO_IP_LOOKUP=0                 # 1: never look up this computer's public IP for a cloud
#                                       #   source's allow list (no request to checkip.amazonaws.com)

# --- The screen -------------------------------------------------------------------------
# EXAKIT_NO_FANCY=0                     # 1: plain text, no colours, spinners or menus
# EXAKIT_NO_MOUSE=0                     # 1: menus do not take mouse clicks
# EXAKIT_HELP_PLAIN=0                   # 1: plain text for exakit help and exakit catalog only

# --- Telemetry --------------------------------------------------------------------------
# EXASOL_TELEMETRY_DISABLE=1            # the kit turns Exasol tools' usage telemetry off; set to an
#                                       #   empty value in the environment to leave it on
