        [ "$_start_id" = "database" ] && continue
        exakit_service_start "$_start_id" || true
    done
    # The database is up, so a note left by an earlier start that could not
    # ("Port 8563 is held by another process ...") is no longer true. Only a
    # runtime note goes; an install-step note is a different fault and stays.
    exakit_runtime_is_running 2>/dev/null && exakit_clear_runtime_failure_note
    return 0
}

cmd_stop() {
    _require_install
    exakit_init_logging 2>/dev/null || true
    # Add-on services first: they talk to the database, so they should be down
    # before it goes.
    for _stop_id in $(exakit_service_ids); do
        [ "$_stop_id" = "database" ] && continue
        exakit_service_stop "$_stop_id" || true
    done
    case "$(_runtime_type)" in
        personal) personal_stop ;;
    esac
}

# exakit_reset_dataset_flags — every bundled dataset's "loaded" record set to
# false, both keys (the dataset.conf flag and the canonical
# data.datasets.<id>.loaded), before a rebuild empties the database. Twin:
# Reset-ExakitDatasetFlags in exakit.ps1.
exakit_reset_dataset_flags() {
    command -v exakit_bundled_datasets >/dev/null 2>&1 || return 0
    _rdf_lines=""
    while IFS='|' read -r _rdf_id _rdf_label _rdf_flag _rdf_markers _rdf_schema; do
        [ -n "$_rdf_id" ] || continue
        _rdf_lines="${_rdf_lines}${_rdf_flag}=false
data.datasets.${_rdf_id}.loaded=false
"
    done <<EXAKIT_RDF
$(exakit_bundled_datasets 2>/dev/null)
EXAKIT_RDF
    [ -n "$_rdf_lines" ] && printf '%s' "$_rdf_lines" | manifest_set_many
    return 0
}

# cmd_repair_runtime [--yes] — rebuild a database that cannot be started.
#
# THE ESCAPE FROM A WEDGE, and the reason it exists: a SIGKILLed Exasol Personal
# runner leaves the launcher's workflow state "interrupted", after which every
# start fails identically forever. Before this command the documented recovery
# was a loop — the installer skipped the deployment step as already done, failed
# at start, and closed by advising a re-run that behaved the same way, while
# EXAKIT_REUSE_DB=0 never got a say because the skip happened first.
#
# Re-running the platform setup script IS the repair: the deployment step already
# knows how to try a start, watch it fail, destroy and deploy fresh. Dropping the
# `runtime` tick first is what lets it be reached, and it also covers a runtime
# whose wedge this kit does not yet recognise. Everything downstream (the MCP
# read-only user, the datasets) is rebuilt by the same run, because a replaced
# database has none of them.
#
# DESTRUCTIVE: the deployment is replaced and its data is gone. Interactive runs
# are asked; --yes and EXAKIT_CONFIRM_RUNTIME_REPAIR=1 pre-answer it.
#
# EXIT 5 MEANS "NOT CONFIRMED, NOTHING WAS TOUCHED". Declining used to return
# 0, so an agent handed `remedies.database: "exakit repair-runtime"` ran it with
# no TTY, read a success code off a command that had deliberately done nothing,
# recorded the repair as done, re-polled `status`, saw `interrupted` again — and
# was in exactly the loop AGENTS.md's "do not loop on exakit start" warning
# exists to prevent, one command over. A distinct code is the whole fix; the
# non-destructive default is right and stays.
cmd_repair_runtime() {
    _rr_json=0
    for _rr_pre in "$@"; do
        case "$_rr_pre" in --json|-j) _rr_json=1 ;; esac
    done
    _require_install "$_rr_json"
    _rr_yes=0
    for _rr_arg in "$@"; do
        case "$_rr_arg" in
            --yes|-y) _rr_yes=1 ;;
            --json|-j) ;;
            *) reject "Unknown option '$_rr_arg' for repair-runtime (supported: --yes, --json)." ;;
        esac
    done
    [ "${EXAKIT_CONFIRM_RUNTIME_REPAIR:-0}" = "1" ] && _rr_yes=1

    _rr_kit="$(exakit_repo_root)" || die "Could not find the kit copy to re-run setup from. Re-run the installer instead."
    case "$(detect_os)" in
        macos)      _rr_setup="setup/setup-macos.sh" ;;
        linux|wsl)  _rr_setup="setup/setup-linux.sh" ;;
        *)          die "repair-runtime has no setup script for this platform. On Windows, re-run install.ps1." ;;
    esac
    [ -f "$_rr_kit/$_rr_setup" ] || die "The kit copy at $_rr_kit has no $_rr_setup. Re-run the installer instead."

    # Narration never shares stdout with the JSON object.
    if [ "$_rr_json" -eq 1 ]; then
        warn "This rebuilds your database from empty. Every table in it is deleted and cannot be recovered." >&2
    else
        warn "This rebuilds your database from empty. Every table in it is deleted and cannot be recovered."
        info "The bundled sample datasets are reloaded afterwards. Anything you loaded yourself is not."
        # A FORMAT THE KIT CAN LOAD BACK. This used to name
        # `exakit sql --json`, whose output is a {"ok", "rows", "row_count"}
        # envelope - readable, but nothing in the kit ingests it: exapump takes
        # .csv and .parquet, and the json-tables path expects raw JSON
        # documents, not a result wrapper. So the one rescue instruction
        # printed before a command that destroys the database produced a file
        # its owner could not restore from. exapump's own CSV output is a
        # plain header-plus-rows file, which `exakit data-load` reads directly.
        info "If the database still answers, copy out anything you want to keep first, one table at a time:"
        info "  exapump sql -p $EXAKIT_EXAPUMP_PROFILE -f csv 'SELECT * FROM <SCHEMA>.<TABLE>' > <TABLE>.csv"
        info "  ...and load it back afterwards with: exakit data-load <TABLE>.csv  (the file name becomes the table name, so keep it)"
    fi
    if [ "$_rr_yes" -ne 1 ]; then
        if ! confirm "Delete everything in the database and rebuild it empty?" n; then
            # DECLINING A DESTRUCTIVE PROMPT IS THE SAFE ANSWER, not an error.
            # die() rendered it as a red error card and exited 1 - and because
            # die() calls exakit_note_failure, it also left `exakit status
            # --json` reporting a last_failure on a machine where nothing had
            # gone wrong. common.sh documents that exact hazard as the reason
            # reject() exists. Nothing is recorded here either — but the code is
            # 5, not 0: "you did not confirm" is not "it is repaired".
            if [ "$_rr_json" -eq 1 ]; then
                printf '{"ok": false, "status": "declined", "reason": "not confirmed", "changed": false, "remedy": "exakit repair-runtime --yes", "remedy_hint": "this DESTROYS the database and its data - ask the user before running it"}\n'
            else
                info "Repair cancelled — nothing was changed."
                info "When you are ready: exakit repair-runtime --yes (or set EXAKIT_CONFIRM_RUNTIME_REPAIR=1)"
            fi
            return 5
        fi
    fi

    exakit_init_logging
    # Drop the tick so the deployment step runs even on a runtime whose wedged
    # state step_artifact_state cannot yet recognise.
    exakit_unmark_step runtime
    # AND THE DATASET FLAGS. The rebuilt database is empty, but the record still
    # said every bundled dataset was loaded - and the data step trusts that
    # record whenever the database cannot be asked, which a database that came
    # up seconds ago sometimes cannot. So the run said "Dataset 'tpch' already
    # loaded" over an empty schema, and the promise two lines above ("reloaded
    # afterwards") was broken. Seen on a real machine.
    exakit_reset_dataset_flags
    info "Re-running $_rr_setup to rebuild the database"
    export EXAKIT_BANNER_SHOWN=1
    # The deployment step must NOT offer to reuse what is there. Its reuse
    # question defaults to YES, so a repair that the user had just confirmed as
    # destructive ("its data is not recoverable") answered itself with "keep the
    # existing database" and reported "Reusing the existing Exasol deployment".
    # The command did not repair anything, and the second question contradicted
    # the first one it had just been given.
    #
    # EXAKIT_REUSE_DB=0 is the documented way to force a fresh deployment, and
    # it is what this command has meant all along. On macOS, declining reuse is
    # deliberately harmless and the deletion has its own consent variable —
    # EXAKIT_REPLACE_DB=1 — which this command may set because the user just
    # answered its own destructive prompt.
    export EXAKIT_REUSE_DB=0
    export EXAKIT_REPLACE_DB=1
    if [ "$_rr_json" -eq 1 ]; then
        # A machine-readable answer has to outlive the rebuild, so this path
        # cannot `exec` the setup script away. Its narration goes to stderr and
        # the log; stdout carries one object and nothing else.
        bash "$_rr_kit/$_rr_setup" >&2
        _rr_rc=$?
        if [ "$_rr_rc" -eq 0 ]; then
            printf '{"ok": true, "status": "repaired", "changed": true, "remedy": null}\n'
            return 0
        fi
        printf '{"ok": false, "status": "failed", "changed": true, "reason": "the rebuild did not finish (see exakit logs)", "remedy": "%s"}\n' \
            "$(exakit_install_command)"
        return 3
    fi
    exec bash "$_rr_kit/$_rr_setup"
}

# cmd_migrate docker-nano [options] — the after-the-install road of the legacy
# crossing (setup/lib/legacy-crossing.sh, legacy_migrate_now).
#
# The installer asks about an older kit's container database exactly once. This
# is for the machine that answered "skip" and wants the data after all, and for
# the one whose container the installer never saw - made by hand with `docker
# run exasol/nano`, or by the upstream kit on a machine this kit was installed
# fresh on. Everything the copy needs can be named on the command line; what is
# not named comes from the record the crossing kept (legacy.*), then from the
# old install's own record, then from the machine (which engine answers for the
# container, which port it publishes), and last from the defaults an older kit
# used (the container `exasol-nano`, the user `sys`).
#
# THE PASSWORD NEVER TRAVELS ON A COMMAND LINE. `ps` is readable by every process
# on the machine, so there is no --password: it comes from a file (--password-
# file, or the one an older kit recorded), from EXAKIT_LEGACY_PASSWORD in the
# environment for a scripted run, or from a prompt on a terminal.
#
# Exit codes are the kit's closed set: 0 done (or nothing of yours to copy),
# 1 the copy did not finish (the reason and the copies' location are printed),
# 2 bad input, 3 no deployment or no exapump to copy with, 4 not installed,
# 5 not confirmed. --json prints one object on stdout and narrates on stderr.
cmd_migrate() {
    _mg_source="${1:-}"
    [ $# -gt 0 ] && shift
    _mg_json=0
    for _mg_a in "$@"; do case "$_mg_a" in --json|-j) _mg_json=1 ;; esac; done
    # A refusal in JSON is an object with rejected: true and exit 2, the shape
    # `exakit sql` already answers with, so one parser reads both.
    _mg_reject() {
        if [ "$_mg_json" -eq 1 ]; then
            printf '{"ok": false, "error": "%s", "remedy": null, "rejected": true}\n' "$(_mg_js "$1")"
            exit 2
        fi
        reject "$1"
    }
    _mg_js() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n'; }
    _mg_usage="exakit migrate docker-nano [--container NAME] [--engine docker|podman] [--dsn HOST:PORT] [--user USER] [--password-file PATH] [--yes] [--json]"
    case "$_mg_source" in
        docker-nano) ;;
        ''|-*) _mg_reject "migrate needs a source. The one there is: $_mg_usage" ;;
        *) _mg_reject "Unknown migration source '$_mg_source' (known: docker-nano)." ;;
    esac
    _mg_yes=0; _mg_container=""; _mg_engine=""; _mg_dsn=""; _mg_user=""; _mg_pwfile=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --container=*)     _mg_container="${1#*=}" ;;
            --container)       shift; _mg_container="${1:-}"; [ -n "$_mg_container" ] || _mg_reject "--container needs the container's name." ;;
            --engine=*)        _mg_engine="${1#*=}" ;;
            --engine)          shift; _mg_engine="${1:-}"; [ -n "$_mg_engine" ] || _mg_reject "--engine needs docker or podman." ;;
            --dsn=*)           _mg_dsn="${1#*=}" ;;
            --dsn)             shift; _mg_dsn="${1:-}"; [ -n "$_mg_dsn" ] || _mg_reject "--dsn needs HOST:PORT." ;;
            --user=*)          _mg_user="${1#*=}" ;;
            --user)            shift; _mg_user="${1:-}"; [ -n "$_mg_user" ] || _mg_reject "--user needs a database user." ;;
            --password-file=*) _mg_pwfile="${1#*=}" ;;
            --password-file)   shift; _mg_pwfile="${1:-}"; [ -n "$_mg_pwfile" ] || _mg_reject "--password-file needs a path." ;;
            --password|--password=*) _mg_reject "A password does not go on the command line, where every process can read it. Put it in a file and pass --password-file <path>, set EXAKIT_LEGACY_PASSWORD, or answer the prompt." ;;
            --yes|-y)          _mg_yes=1 ;;
            --json|-j)         ;;
            *) _mg_reject "Unknown option '$1' for migrate (supported: --container, --engine, --dsn, --user, --password-file, --yes, --json)." ;;
        esac
        shift
    done
    case "$_mg_engine" in
        ''|docker|podman) ;;
        *) _mg_reject "--engine must be docker or podman, not '$_mg_engine'." ;;
    esac
    case "$_mg_dsn" in
        ''|*:[0-9]*) ;;
        *) _mg_reject "--dsn must be HOST:PORT, e.g. 127.0.0.1:8563." ;;
    esac
    [ -z "$_mg_pwfile" ] || [ -s "$_mg_pwfile" ] || _mg_reject "--password-file: $_mg_pwfile is missing or empty."

    _require_install "$_mg_json"
    # One answer for a failure BEFORE the copy: the same three keys every state
    # query carries, exit 3 - the code for "installed, but not usable for this".
    _mg_refuse() {
        if [ "$_mg_json" -eq 1 ]; then
            printf '{"ok": false, "installed": true, "status": "%s", "error": "%s", "remedy": "%s"}\n' \
                "$(_mg_js "$1")" "$(_mg_js "$2")" "$(_mg_js "$3")"
            exit 3
        fi
        error "$2"
        info "Then: $3"
        exit 3
    }
    [ "$(_runtime_type)" = "personal" ] || \
        _mg_refuse "no database" "This install has no Exasol Personal deployment to copy into yet." "$(exakit_install_command)"
    command -v legacy_migrate_now >/dev/null 2>&1 || \
        die "This kit copy has no setup/lib/legacy-crossing.sh, which migrate runs. Re-run the installer to repair the copy."

    # What was named, then what the crossing remembered (legacy.*), then the old
    # install's own record - runtime.* is only the OLD database's when the
    # record still says the runtime is a container - then the machine.
    _mg_legacy_rt=0
    exakit_legacy_runtime_recorded 2>/dev/null && _mg_legacy_rt=1
    _mg_rec() { manifest_get "legacy.$1" 2>/dev/null || true; }
    _mg_old() { [ "$_mg_legacy_rt" = 1 ] && manifest_get "runtime.$1" 2>/dev/null || true; }
    EXAKIT_LEGACY_CONTAINER="${_mg_container:-$(_mg_rec container)}"
    [ -n "$EXAKIT_LEGACY_CONTAINER" ] || EXAKIT_LEGACY_CONTAINER="$(_mg_old container)"
    [ -n "$EXAKIT_LEGACY_CONTAINER" ] || EXAKIT_LEGACY_CONTAINER="exasol-nano"
    EXAKIT_LEGACY_VOLUME="$(_mg_rec volume)"
    [ -n "$EXAKIT_LEGACY_VOLUME" ] || EXAKIT_LEGACY_VOLUME="$(_mg_old volume)"
    EXAKIT_LEGACY_USER="${_mg_user:-$(_mg_rec user)}"
    [ -n "$EXAKIT_LEGACY_USER" ] || EXAKIT_LEGACY_USER="$(_mg_old user)"
    [ -n "$EXAKIT_LEGACY_USER" ] || EXAKIT_LEGACY_USER="sys"
    EXAKIT_LEGACY_ENGINE="${_mg_engine:-$(_mg_rec engine)}"
    [ -n "$EXAKIT_LEGACY_ENGINE" ] || EXAKIT_LEGACY_ENGINE="$(_mg_old engine)"
    if [ -z "$EXAKIT_LEGACY_ENGINE" ]; then
        # Whichever engine on this machine knows a container by that name.
        for _mg_e in docker podman; do
            command -v "$_mg_e" >/dev/null 2>&1 || continue
            if exakit_run_bounded "${EXAKIT_ENGINE_PROBE_TIMEOUT:-20}" "$_mg_e" container inspect "$EXAKIT_LEGACY_CONTAINER" >/dev/null 2>&1; then
                EXAKIT_LEGACY_ENGINE="$_mg_e"; break
            fi
        done
        [ -n "$EXAKIT_LEGACY_ENGINE" ] || _mg_refuse "no container" \
            "Neither docker nor podman on this machine has a container named '$EXAKIT_LEGACY_CONTAINER'." \
            "exakit migrate docker-nano --engine docker --container <name>   (list them with: docker ps -a, or podman ps -a)"
    fi
    EXAKIT_LEGACY_DSN="${_mg_dsn:-$(_mg_rec dsn)}"
    [ -n "$EXAKIT_LEGACY_DSN" ] || EXAKIT_LEGACY_DSN="$(_mg_old dsn)"
    if [ -z "$EXAKIT_LEGACY_DSN" ]; then
        # The port the container publishes for 8563, as the engine reports it
        # ("127.0.0.1:8563", or "0.0.0.0:8563" - either way the host is local).
        _mg_port="$(exakit_run_bounded "${EXAKIT_ENGINE_PROBE_TIMEOUT:-20}" "$EXAKIT_LEGACY_ENGINE" port "$EXAKIT_LEGACY_CONTAINER" 8563/tcp 2>/dev/null | grep -v '^\[' | head -1 | sed 's/.*://')"
        case "$_mg_port" in
            ''|*[!0-9]*) _mg_port=8563 ;;
        esac
        EXAKIT_LEGACY_DSN="127.0.0.1:$_mg_port"
    fi
    # The password: a named file, the environment, the recorded file, the
    # credential an older kit kept, and last a prompt - on a terminal only.
    EXAKIT_LEGACY_PASSWORD_FILE=""
    if [ -n "$_mg_pwfile" ]; then
        EXAKIT_LEGACY_PASSWORD_FILE="$_mg_pwfile"
    elif [ -z "${EXAKIT_LEGACY_PASSWORD:-}" ]; then
        _mg_pf="$(_mg_rec password_file)"
        [ -n "$_mg_pf" ] && [ -s "$_mg_pf" ] || _mg_pf="$(_mg_old password_file)"
        [ -n "$_mg_pf" ] && [ -s "$_mg_pf" ] || _mg_pf="$EXAKIT_CREDS_DIR/nano_sys_password"
        if [ -s "$_mg_pf" ]; then
            EXAKIT_LEGACY_PASSWORD_FILE="$_mg_pf"
        else
            _mg_tty="$(_exakit_prompt_tty 2>/dev/null || true)"
            [ "$_mg_json" -eq 1 ] && _mg_tty=""
            if [ -n "$_mg_tty" ]; then
                [ "$_mg_tty" = stdin ] && _mg_tty=/dev/stdin
                printf '    %s?%s Password of the %s user in the old database (not shown): ' "${UI_ASK:-}" "${UI_RESET:-}" "$EXAKIT_LEGACY_USER" > "$_mg_tty"
                IFS= read -rs EXAKIT_LEGACY_PASSWORD < "$_mg_tty" || EXAKIT_LEGACY_PASSWORD=""
                printf '\n' > "$_mg_tty"
                [ -n "$EXAKIT_LEGACY_PASSWORD" ] || _mg_reject "No password was given."
            else
                _mg_refuse "no password" \
                    "The old database's password is not on file, and there is no terminal to ask on." \
                    "exakit migrate docker-nano --password-file <path>   (a file holding only the password; or set EXAKIT_LEGACY_PASSWORD)"
            fi
        fi
    fi

    exakit_init_logging 2>/dev/null || true
    if [ "$_mg_json" -eq 1 ]; then
        # The narration goes to stderr; stdout carries one object and nothing else.
        legacy_migrate_now "$_mg_yes" >&2
        _mg_rc=$?
        _mg_ok=false
        case "$EXAKIT_LEGACY_MIGRATE_STATUS" in done|nothing) _mg_ok=true ;; esac
        _mg_remedy=null
        [ -n "${EXAKIT_LEGACY_MIGRATE_REMEDY:-}" ] && _mg_remedy="\"$(_mg_js "$EXAKIT_LEGACY_MIGRATE_REMEDY")\""
        [ "$EXAKIT_LEGACY_MIGRATE_STATUS" = declined ] && _mg_remedy='"exakit migrate docker-nano --yes"'
        _mg_reason=null
        [ -n "${EXAKIT_LEGACY_MIGRATE_REASON:-}" ] && _mg_reason="\"$(_mg_js "$EXAKIT_LEGACY_MIGRATE_REASON")\""
        _mg_sample="[]"
        [ -n "${EXAKIT_LEGACY_SAMPLE_IDS:-}" ] && _mg_sample="[\"$(printf '%s' "$EXAKIT_LEGACY_SAMPLE_IDS" | sed 's/,/", "/g')\"]"
        printf '{"ok": %s, "installed": true, "status": "%s", "container": "%s", "engine": "%s", "dsn": "%s", "copied_out": %s, "restored": %s, "left_alone": %s, "failed": %s, "sample_left_out": %s, "reason": %s, "remedy": %s}\n' \
            "$_mg_ok" "$(_mg_js "${EXAKIT_LEGACY_MIGRATE_STATUS:-failed}")" \
            "$(_mg_js "$EXAKIT_LEGACY_CONTAINER")" "$(_mg_js "$EXAKIT_LEGACY_ENGINE")" "$(_mg_js "$EXAKIT_LEGACY_DSN")" \
            "${EXAKIT_LEGACY_EXPORTED:-0}" "${EXAKIT_LEGACY_RESTORED:-0}" "${EXAKIT_LEGACY_SKIPPED:-0}" "${EXAKIT_LEGACY_RESTORE_FAILED:-0}" \
            "$_mg_sample" "$_mg_reason" "$_mg_remedy"
        exit "$_mg_rc"
    fi
    legacy_migrate_now "$_mg_yes"
    exit $?
}

# cmd_autostart — one command: show where it stands, then offer to flip it.
#
# It was three (`on`, `off`, and a bare form that only reported), which made the
# reader pick the verb before being told what the current state even was -- and
# the bare form then closed by explaining the other two. Now the answer comes
# first and the only decision left is yes or no.
#
# EXAKIT_AUTOSTART_CHANGE pre-answers it for automation, the same contract every
# other prompt in the kit uses; without a terminal the default is NO CHANGE, so
# a scripted run can never silently flip a boot setting.
cmd_autostart() {
    # Bad input first: AGENTS.md promises exit 2 for it on ANY command, and
    # checking the install first answered `exakit autostart off` with 4 ("not
    # installed") wherever no kit was present - the wrong class of answer.
    [ "$#" -eq 0 ] || \
        reject "autostart takes no arguments — run 'exakit autostart' and answer the question."
    _require_install
    exakit_init_logging 2>/dev/null || true

    exakit_autostart_print

    _as_total=0
    _as_on=0
    for _as_id in $(exakit_service_ids); do
        _as_total=$(( _as_total + 1 ))
        if _exakit_autostart_registered "$_as_id"; then _as_on=$(( _as_on + 1 )); fi
    done
    [ "$_as_total" -gt 0 ] || return 0

    # "Everything is on" is the only state that offers to turn things off;
    # anything else -- none of it, or some of it -- offers to turn it all on,
    # because a partly-registered set is the one a reader wants made whole.
    if [ "$_as_on" -eq "$_as_total" ]; then
        confirm_env EXAKIT_AUTOSTART_CHANGE "Turn it off?" n || return 0
        exakit_autostart_disable
    else
        confirm_env EXAKIT_AUTOSTART_CHANGE "Turn it on?" n || return 0
        exakit_autostart_enable
    fi
}

cmd_uninstall() {
    # Distinct variable names (_uni_*): exakit_uninstall_run assigns globals like
    # _dry without `local`, so a plain _dry here would be clobbered by the
    # plan-display call below.
    _uni_yes=0
    _uni_dry=0
    _uni_addon=""
    for _uni_arg in "$@"; do
        case "$_uni_arg" in
            -y|--yes)      _uni_yes=1 ;;
            -n|--dry-run)  _uni_dry=1 ;;
            -*) reject "Unknown option '$_uni_arg' for uninstall (supported: --yes, --dry-run, or one add-on id)." ;;
            *)
                # A marketplace add-on by name: selective removal an agent or a
                # script can call, instead of the TTY-only menu being the sole
                # route to removing one piece.
                _exakit_addon_registered "$_uni_arg" || \
                    reject "Unknown uninstall target '$_uni_arg' (known add-ons: $(exakit_marketplace_addons | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//'); bare 'exakit uninstall' removes the kit)."
                [ -n "$_uni_addon" ] && reject "uninstall takes at most one add-on id."
                _uni_addon="$_uni_arg"
                ;;
        esac
    done
    exakit_init_logging 2>/dev/null || true

    if [ -n "$_uni_addon" ]; then
        [ -f "$EXAKIT_MANIFEST" ] || die "No installation found. Run the installer first."
        if ! exakit_marketplace_addon_installed "$_uni_addon" 2>/dev/null; then
            info "$_uni_addon is not installed — nothing to remove."
            exit 0
        fi
        if [ "$_uni_dry" = 1 ]; then
            # The add-on's own hook narrates its plan: a fixed sentence here
            # said "nothing else" while dash-server's hook deleted every
            # dashboard, so the preview has to come from the code that removes.
            info "Dry run — removing the $_uni_addon add-on would:"
            _exakit_uninstall_component "$_uni_addon" 1
            exit 0
        fi
        if [ "$_uni_yes" -ne 1 ]; then
            confirm "Remove the $_uni_addon add-on?" n || {
                # EXIT 5, THE SAME AS repair-runtime's DECLINE thirty lines up.
                # AGENTS.md defines 5 as "a command you did not confirm", and
                # this path answered 0 - which means "done" to anything reading
                # the code. An agent told to remove an add-on, running without
                # a terminal so confirm() takes its default of no, was told the
                # removal had succeeded and moved on; the add-on is still
                # there. Declining is not an error (nothing is recorded, and
                # the message is an info, not a die), but it is not success
                # either, and the two must not share a code.
                info "Nothing was removed."
                info "When you are ready: exakit uninstall $_uni_addon --yes"
                exit 5
            }
        fi
        _exakit_uninstall_component "$_uni_addon" 0
        ok "$_uni_addon removed. Reinstall any time with: exakit marketplace $_uni_addon"
        exit 0
    fi

    # Nothing installed anywhere we can see? Say so and stop.
    if [ ! -f "$EXAKIT_MANIFEST" ] && [ ! -e "$EXAKIT_BIN_DIR/exasol" ] && \
       [ ! -e "$EXAKIT_BIN_DIR/exakit" ] && [ ! -d "$EXAKIT_HOME" ]; then
        info "Nothing to uninstall — no manifest, kit home, or installed binaries were found."
        exit 0
    fi

    # --dry-run previews the FULL plan; --yes is the scripted full uninstall
    # (automation and AGENTS.md rely on both). Everything else goes through
    # the selectable menu: pick what goes, see what that means, type the word.
    if [ "$_uni_dry" = 1 ]; then
        printf '\n'
        warn "exakit uninstall PERMANENTLY removes the Exasol Personal Local Starter Kit."
        info "A full uninstall (the EVERYTHING row, or --yes) removes:"
        exakit_uninstall_run 1
        printf '\n'
        info "Not touched: uv/uvx (shared tool), any PATH line in your shell profile, and anything the kit did not install."
        info "Dry run only — nothing was removed. Pick individual pieces interactively with: exakit uninstall"
        exit 0
    fi

    if [ "$_uni_yes" = 1 ]; then
        printf '\n'
        warn "exakit uninstall --yes removes the FULL kit (all local database data included)."
        # THE PLAN RUNS ON THIS PATH TOO, not only under --dry-run. --yes is
        # what AGENTS.md documents for automation, so it is the path an agent
        # takes when a user says "uninstall the starter kit" - and it used to
        # print one warn line and then destroy, leaving no record anywhere of
        # WHAT it destroyed. The kit has no data-export facility (see
        # exakit_update_runtime's note), so the database's contents are gone
        # with no recoverable copy; the least this can do is name them first,
        # in the transcript the agent keeps and in the log.
        info "About to remove:"
        exakit_uninstall_run 1
        printf '\n'
        info "There is no export step: the kit cannot copy your tables out, and this does not stop to ask."
        info "To keep anything, stop now (Ctrl-C) and copy it out first, one table at a time:"
        info "  exapump sql -p $EXAKIT_EXAPUMP_PROFILE -f csv 'SELECT * FROM <SCHEMA>.<TABLE>' > <TABLE>.csv"
        info "  ...which exakit data-load <TABLE>.csv loads back into a new install (the file name becomes the table name)."
        printf '\n'
        exakit_uninstall_run 0
        printf '\n'
        ok "Uninstall complete — the Exasol Personal Local Starter Kit has been removed."
        info "If a PATH entry for $EXAKIT_BIN_DIR remains in your shell profile (~/.zshrc, ~/.bashrc, ~/.profile), remove it manually if you no longer need it."
        exit 0
    fi

    exakit_uninstall_menu
}

# cmd_version — one screen for "what have I got, and is any of it out of date?"
#
# This used to be two commands. `exakit version` listed what was installed and
# `exakit update-check` compared it against the advertised set, so answering the
# only question either was ever asked meant running both and reading one screen
# against the other. The Kit panel below is the part with no
# component/version/status shape; everything else is the table in
# exakit_print_version_table.
# ⇄ twin: Invoke-CmdVersion in setup/exakit.ps1.
cmd_version() {
    _cv_json=0
    for _cv_arg in "$@"; do
        case "$_cv_arg" in
            --json|-j) _cv_json=1 ;;
            *) reject "Unknown option '$_cv_arg' for version (supported: --json)." ;;
        esac
    done
    # Exit 4, not 0: an agent using `version` as a cheap liveness probe read a
    # success code off a machine with nothing installed.
    [ -f "$EXAKIT_MANIFEST" ] || { [ "$_cv_json" -eq 1 ] && _not_installed_answer 1; echo "Not installed (no manifest at $EXAKIT_MANIFEST)"; exit 4; }
    if [ "$_cv_json" -eq 1 ]; then
        exakit_can_run_python || die "python3 is needed for --json."
        exakit_print_version_table --json
        exit $?
    fi
    ui_panel_begin "Kit"
    ui_panel_line "$(printf '%-14s %s' Version "$(exakit_component_current exakit 2>/dev/null || printf 'unknown')")"
    # No "Level" row: an internal schema number, meaningless to the reader.
    # No "Source" row either: an absolute path to the kit's own copy of itself,
    # which answers a question nobody asks of a version screen.
    ui_panel_line "$(printf '%-14s %s' Installed "$(exakit_format_local_time "$(manifest_get installed_at 2>/dev/null)")")"
    ui_panel_end
    printf '\n'
    exakit_print_version_table
}

