# cmd_marketplace [--list [--json]] [<addon-id>...] — bare, it browses (and
# without a terminal it installs NOTHING; the menu says how to ask
# explicitly). --list is the read-only surface an agent can always call;
# --json makes it machine-readable. Ids are a targeted install: `exakit
# marketplace dash-server` installs dash-server and nothing else — it used to
# silently DISCARD the id and install the other pending add-ons instead.
cmd_marketplace() {
    [ -f "$EXAKIT_MANIFEST" ] || die "No installation found. Run the installer first."
    _cm_list=0
    _cm_json=0
    _cm_ids=""
    for _cm_arg in "$@"; do
        case "$_cm_arg" in
            --list) _cm_list=1 ;;
            --json) _cm_json=1 ;;
            -*) reject "Unknown option '$_cm_arg' for marketplace (supported: --list, --json, or add-on ids to install)." ;;
            *)
                if _exakit_addon_registered "$_cm_arg"; then
                    _cm_ids="${_cm_ids:+$_cm_ids,}$_cm_arg"
                else
                    reject "Unknown marketplace add-on '$_cm_arg' (known: $(exakit_marketplace_addons | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//'))."
                fi
                ;;
        esac
    done
    if [ "$_cm_list" -eq 1 ] || [ "$_cm_json" -eq 1 ]; then
        [ -n "$_cm_ids" ] && reject "marketplace --list is read-only and cannot be combined with add-on ids to install."
        exakit_marketplace_list "$_cm_json"
        return $?
    fi
    exakit_init_logging
    if [ -n "$_cm_ids" ]; then
        EXAKIT_MARKETPLACE_ADDONS="$_cm_ids" exakit_marketplace_menu
        return $?
    fi
    exakit_marketplace_menu
}

usage() {
    # Every help screen is rendered from setup/help/*.json - see help.sh. The
    # argument decides which: nothing for the everyday overview, --all for the
    # full command list, a component id for its page, anything else for one
    # command's detail. --json hands the underlying document to a script
    # instead of drawing it, so an agent never has to scrape the screen.
    _u_json=0
    _u_topic=""
    for _u_arg in "$@"; do
        case "$_u_arg" in
            --json|-j) _u_json=1 ;;
            *) [ -n "$_u_topic" ] || _u_topic="$_u_arg" ;;
        esac
    done
    if [ "$_u_json" -eq 1 ]; then
        exakit_can_run_python || die "python3 is needed for --json."
        case "$_u_topic" in
            --all|-a|"") exakit_help_render json all ;;
            *)           exakit_help_render json "$_u_topic" ;;
        esac
        return $?
    fi
    case "$_u_topic" in
        --all|-a) exakit_help_render all ;;
        "")       exakit_help_render overview ;;
        *)        if exakit_help_is_id "$_u_topic"; then
                      exakit_help_render component "$_u_topic"
                  else
                      exakit_help_render command "$_u_topic"
                  fi ;;
    esac
}

# cmd_info_json — the install record plus the state keys, on stdout.
#
# manifest.json is what every other command reads: which runtime, which versions,
# which paths, what the last data load did. `exakit info --json` hands that to a
# script or a support thread without anyone having to know where the file lives.
#
# Printed byte for byte rather than re-serialised: this is a copy of the file, and
# a reformatting step could only make it disagree with the file. The writer already
# emits two-space-indented JSON with a trailing newline (manifest_set).
#
# Nothing else may reach stdout on this path — no banner, no update notice, no
# hint — or the output stops being JSON. The dispatcher keeps it out of
# `_with_notice` for exactly that reason, and the failure below goes to stderr.
#
# Secrets are not a concern here: the manifest stores password *file paths*
# (runtime.password_file, components.mcp_server.connection.password_file), never a
# password. Keep it that way.
# cmd_info — the human form of the same state query, WITH THE SAME EXIT CODE.
#
# AGENTS.md lists `exakit info` in its "Verify the install" block, and it
# answered 0 off a kit whose database was not running and 1 (an undocumented
# code) with no install at all — while `info --json` answered 3 and 4 for those
# same two machines. An agent cross-checking two state queries got two
# different verdicts for one state. connection_panel keeps its own return
# value: the installer prints the same panel and must not exit on it.
cmd_info() {
    [ -f "$EXAKIT_MANIFEST" ] || _not_installed_answer 0
    connection_panel || true
    exakit_runtime_is_running && return 0
    return 3
}

cmd_info_json() {
    [ -s "$EXAKIT_MANIFEST" ] || _not_installed_answer 1
    # THE SAME TRI-STATE AS `status`, in the exit code AND in the document.
    # AGENTS.md promises `installed`, `status` and `remedy` in every --json
    # answer; this one printed the raw manifest, so a parser branching on
    # .status the way it was told hit a KeyError on exactly the state worth
    # branching on. The record is the manifest, complete, plus those three keys.
    if exakit_runtime_is_running; then _ij_running=1; else _ij_running=0; fi
    # The skill set's advertised version, from the CACHED versions document
    # (no network): info says when `exakit update` has a newer set to fetch,
    # the way `exakit version` does, without becoming a network call.
    _ij_skills_want="$(exakit_versions_value components.skills.version 2>/dev/null || true)"
    # No runtime recorded means no database exists yet, so "exakit start" is
    # the one command that cannot help. `status --json` answers "no database"
    # with the installer's command for this same machine state; two state
    # queries may not disagree about it.
    _ij_rtype="$(_runtime_type 2>/dev/null || true)"
    if exakit_can_run_python_any; then
        run_python_any - "$EXAKIT_MANIFEST" "$_ij_running" "$_ij_skills_want" "${_ij_rtype:-}" "$(exakit_install_command)" <<'EXAKIT_IJ_PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    doc = json.load(handle)
running = sys.argv[2] == "1"
rtype = sys.argv[4]
install_cmd = sys.argv[5]
doc["installed"] = True
if running:
    doc["status"] = "running"
    doc["remedy"] = None
elif not rtype:
    doc["status"] = "no database"
    doc["remedy"] = install_cmd
    doc["remedy_hint"] = "no runtime is recorded yet; the installer resumes at the unfinished step"
else:
    # "stopped" - the same word status --json uses for this state. See the
    # note in cmd_mcp_doctor: the status field is the machine's, and it has
    # one value per state.
    doc["status"] = "stopped"
    doc["database"] = "not running"
    doc["remedy"] = "exakit start"
skills_have = ((doc.get("components") or {}).get("skills") or {}).get("version")
skills_want = sys.argv[3] or None
doc["skills"] = {
    "installed_version": skills_have,
    "advertised_version": skills_want,
    "status": "update_pending" if (skills_have and skills_want and skills_have != skills_want) else "current",
    "next": "exakit update" if (skills_have and skills_want and skills_have != skills_want) else None,
}
print(json.dumps(doc, indent=2))
EXAKIT_IJ_PY
    else
        cat "$EXAKIT_MANIFEST"
    fi
    [ "$_ij_running" -eq 1 ] && exit 0
    exit 3
}

# cmd_sql <statement> [--write] — run one SQL statement and translate the error.
#
# WHY THIS EXISTS: the kit has an error translator that turns the three raw
# engine faults every agent hits first into a remedy ("use LIMIT", "exakit
# start", "describe it first"), and it was wired ONLY into the kit's own internal
# setup SQL — the one path no agent ever sees. Running SQL the documented way
# (`exapump sql -p starter-kit`) produced the raw engine text with a generic
# hint, so "every error message names its remedy" was true of the lifecycle
# commands and false of the SQL path the skill tells the agent to use for every
# validation. This is that path, with the translator attached.
#
# NOT A SANDBOX, and the help says so. The `starter-kit` profile is the ADMIN
# connection; the statement gate below is a seatbelt against a typo, not a
# security boundary. The boundary is the MCP read-only user, which the database
# itself enforces. --write is how you say you meant it.
# _sql_reject <message> — a refusal, in the shape the caller asked for. In
# --json mode a typo, a write without --write or a second statement used to
# print the human "[x]" line on stderr and leave stdout empty; a parser got
# nothing. Exit 2 either way, and still nothing recorded as a failure.
_sql_reject() {
    if [ "${_sql_json:-0}" -eq 1 ]; then
        run_python - "$1" <<'EXAKIT_SQL_REJECT_PY'
import json, sys
print(json.dumps({"ok": False, "error": sys.argv[1], "remedy": None, "rejected": True}))
EXAKIT_SQL_REJECT_PY
        _exakit_log_file "REJECT $1"
        exit 2
    fi
    reject "$1"
}

cmd_sql() {
    _sql_write=0
    _sql_json=0
    # Known before the arguments are walked, so a refusal raised WHILE walking
    # them (an unknown option, two statements) already answers in JSON — and so
    # the install check below can answer in JSON too, instead of a human error
    # card on the machine-readable path.
    for _sql_pre in "$@"; do
        case "$_sql_pre" in --json|-j) _sql_json=1 ;; esac
    done
    _require_install "$_sql_json"
    _sql_text=""
    _sql_file=""
    _sql_expect_file=0
    # Everything after a bare `--` is the statement, never a flag.
    _sql_end_opts=0
    for _sql_arg in "$@"; do
        if [ "$_sql_expect_file" -eq 1 ]; then _sql_file="$_sql_arg"; _sql_expect_file=0; continue; fi
        if [ "$_sql_end_opts" -eq 1 ]; then
            [ -n "$_sql_text" ] && _sql_reject "Pass ONE statement, quoted: exakit sql 'SELECT 1'"
            _sql_text="$_sql_arg"; continue
        fi
        case "$_sql_arg" in
            # A STATEMENT WHOSE FIRST LINE IS AN SQL COMMENT IS SQL, NOT A FLAG.
            # `exakit sql '-- monthly revenue<newline>SELECT 1'` was refused as
            # "Unknown option", with the whole statement echoed into the option
            # slot — and commented SQL is the normal shape of anything an agent
            # shows a user before running, and of anything read out of
            # ~/.exasol-starter-kit/workflows/. Options are single tokens: one
            # that carries a newline, or opens with the "-- " of a comment, is
            # the query. The comment stripper below then drops those lines, as
            # it always has for --file and stdin.
            "-- "*|*"
"*) [ -n "$_sql_text" ] && _sql_reject "Pass ONE statement, quoted: exakit sql 'SELECT 1'"
               _sql_text="$_sql_arg" ;;
            --) _sql_end_opts=1 ;;
            --help|-h)
                # The universal --help hook skips this command because a statement
                # may contain "--help" as text; a lone flag is unambiguous.
                [ "$#" -eq 1 ] && { exakit_help_render command sql; exit $?; }
                _sql_reject "Pass ONE statement, quoted: exakit sql 'SELECT 1'" ;;
            --write) _sql_write=1 ;;
            --json|-j) _sql_json=1 ;;
            --file|-f) _sql_expect_file=1 ;;
            --file=*) _sql_file="${_sql_arg#--file=}" ;;
            --*) _sql_reject "Unknown option '$_sql_arg' for sql (supported: --file <path>, --json, --write, --help). If that was your SQL, its first line is a '--' comment: put a space after the dashes, pass the statement after a bare '--', or save it and use exakit sql --file <path>." ;;
            *) [ -n "$_sql_text" ] && _sql_reject "Pass ONE statement, quoted: exakit sql 'SELECT 1'" ; _sql_text="$_sql_arg" ;;
        esac
    done
    [ "$_sql_expect_file" -eq 0 ] || _sql_reject "--file needs a path: exakit sql --file ~/.exasol-starter-kit/workflows/query.sql"
    # The saved-workflow path the skill teaches: `exakit sql --file <path>` or
    # `exakit sql < file`. Neither worked — stdin was never read, and a file's
    # leading "-- comment" line was parsed as an option — so the only way to
    # rerun a saved statement was exapump on the admin connection.
    if [ -n "$_sql_file" ]; then
        [ -z "$_sql_text" ] || _sql_reject "Pass either a statement or --file, not both."
        [ -f "$_sql_file" ] || _sql_reject "No such file: $_sql_file"
        _sql_text="$(cat "$_sql_file")"
    elif [ -z "$_sql_text" ] && ! exakit_stdin_is_tty; then
        _sql_text="$(cat)"
    fi
    # Comment lines and a trailing ';' are what a saved file carries; drop them
    # so the gate below sees the statement.
    _sql_text="$(printf '%s\n' "$_sql_text" | sed -e '/^[[:space:]]*--/d' -e '/^[[:space:]]*$/d' | sed -e '$ s/;[[:space:]]*$//')"
    [ -n "$_sql_text" ] || _sql_reject "Nothing to run. Usage: exakit sql 'SELECT ...'   or   exakit sql --file <path>   [--write]"

    if [ "$_sql_write" -ne 1 ]; then
        # Normalise for the check only; the statement runs exactly as given.
        _sql_probe="$(printf '%s' "$_sql_text" | tr '\n\t' '  ' | sed 's/^ *//')"
        _sql_word="$(printf '%s' "$_sql_probe" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z].*$//')"
        case "$_sql_word" in
            SELECT|WITH|DESCRIBE|DESC|EXPLAIN|SHOW) : ;;
            INSERT|UPDATE|DELETE|MERGE|CREATE|DROP|ALTER|TRUNCATE|GRANT|REVOKE|COMMIT|ROLLBACK|IMPORT|EXPORT|EXECUTE|CALL|SET|OPEN|CLOSE|KILL|FLUSH|RENAME|COMMENT|RECOMPRESS|REORGANIZE|PRELOAD|ENFORCE)
                _sql_reject "That is not a read statement, and 'exakit sql' defaults to reads. Re-run with --write if you mean it — and note the profile it uses is the ADMIN connection, not the read-only MCP user." ;;
            *)
                # Neither a read nor a known write is almost always a typo. This
                # used to be reported as a write attempt and pointed at --write,
                # the one hint that sends an agent to the admin connection.
                _sql_reject "'${_sql_word:-$(printf '%s' "$_sql_probe" | cut -c1-12)}' is not an SQL statement this command recognises — check the spelling. Reads start with SELECT, WITH, DESCRIBE, EXPLAIN or SHOW; a write needs --write." ;;
        esac
        # Reject a second statement outright. The MCP tool gate lets
        # "SELECT 1; DROP TABLE T" through because it only inspects the opening
        # keyword — the engine happens to refuse it, but nothing above the engine
        # does. Refusing it here costs nothing and removes the same footgun.
        case "$(printf '%s' "$_sql_probe" | sed 's/;* *$//')" in
            *";"*) _sql_reject "Only one statement at a time. A trailing ';' is fine; a second statement is not." ;;
        esac
    fi

    # With exapump missing, the run below exited 127 and bash's own "No such
    # file or directory" line - a line-number message about this script, not
    # the database - became the JSON error field. Answer the contract instead:
    # a real reason, the repair command, and the incomplete-install exit code.
    _sql_bin="$(exapump_cli)"
    if [ ! -x "$_sql_bin" ]; then
        if [ "$_sql_json" -eq 1 ]; then
            printf '{"ok": false, "error": "exapump (the SQL client) is not installed", "remedy": "exakit update"}\n'
        else
            error "exapump (the SQL client) is not installed."
            info "Repair it with: exakit update"
        fi
        exit 3
    fi

    if [ "$_sql_json" -eq 1 ]; then
        # One JSON object on stdout, nothing else there. exapump's own
        # `--format json` already puts the rows on stdout and every "[1/1] ..."
        # and "1 statement executed" line on stderr, so the two are separable
        # without parsing - the CSV mode interleaves them. Shape:
        #   {"ok": true,  "rows": [...]}
        #   {"ok": false, "error": "<engine text>", "remedy": "<...>" | null}
        # The remedy is the same one the human form prints first; an agent gets
        # it at a key instead of inside the text. Exit code unchanged.
        # Rows, error text and remedy travel through FILES. Handed to Python as
        # arguments, a 120,000-row result hit the OS argument-size limit
        # ("Argument list too long"), stdout stayed empty and the exit code was
        # 0 - a silent success, the worst answer an agent can be given.
        _sql_err="$(mktemp "${TMPDIR:-/tmp}/exakit-sql-err.XXXXXX")"
        _sql_rowsf="$(mktemp "${TMPDIR:-/tmp}/exakit-sql-rows.XXXXXX")"
        _sql_remf="$(mktemp "${TMPDIR:-/tmp}/exakit-sql-remedy.XXXXXX")"
        "$(exapump_cli)" sql -p "$EXAKIT_EXAPUMP_PROFILE" -f json "$_sql_text" >"$_sql_rowsf" 2>"$_sql_err"
        _sql_rc=$?
        _sql_cmd=""
        if [ "$_sql_rc" -ne 0 ]; then
            # The COMMAND and the SENTENCE travel separately: the contract says
            # remedy is runnable verbatim or null, so the prose the human path
            # prints becomes remedy_hint here, never the remedy itself.
            exakit_db_error_remedy "$(cat "$_sql_err" 2>/dev/null)" "$_sql_text" > "$_sql_remf"
            _sql_cmd="$(exakit_db_error_remedy_cmd "$(cat "$_sql_err" 2>/dev/null)")"
        fi
        run_python - "$_sql_rc" "$_sql_rowsf" "$_sql_err" "$_sql_remf" "$_sql_cmd" <<'EXAKIT_SQL_JSON_PY'
import json, sys
rc = int(sys.argv[1])
def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return ""
rows, err, remedy = read(sys.argv[2]), read(sys.argv[3]), read(sys.argv[4])
remedy_cmd = sys.argv[5] if len(sys.argv) > 5 else ""
if rc == 0:
    try:
        parsed = json.loads(rows) if rows.strip() else []
    except ValueError:
        parsed = []
    print(json.dumps({"ok": True, "rows": parsed, "row_count": len(parsed) if isinstance(parsed, list) else None}))
else:
    # The engine's message, not exapump's framing: the first line that carries
    # an error, with the generic "Hint:" left out because the remedy is the hint.
    # exapump ends a failed run with one "Error: <engine text>" line; that is
    # the message. Failing that, the first line that reads like a failure and
    # is not exapump's own framing ("Error in statement 1:", "Hint: ...").
    lines = [l.strip() for l in err.splitlines() if l.strip()]
    summary = [l for l in lines if l.startswith("Error: ")]
    if summary:
        detail = summary[-1][len("Error: "):]
    else:
        detail = next((l for l in lines if ("rror" in l or "failed" in l)
                       and not l.startswith("Hint:") and not l.startswith("Error in statement")),
                      lines[0] if lines else "query failed")
    print(json.dumps({"ok": False, "error": detail,
                      "remedy": remedy_cmd.strip() or None,
                      "remedy_hint": remedy.strip() or None}))
EXAKIT_SQL_JSON_PY
        _sql_py_rc=$?
        rm -f "$_sql_err" "$_sql_rowsf" "$_sql_remf"
        # The object is the answer; if it could not be produced, say so as one.
        if [ "$_sql_py_rc" -ne 0 ]; then
            printf '{"ok": false, "error": "exakit could not render the result as JSON (see exakit logs)", "remedy": null}\n'
            return 1
        fi
        return "$_sql_rc"
    fi
    _sql_out="$("$(exapump_cli)" sql -p "$EXAKIT_EXAPUMP_PROFILE" "$_sql_text" 2>&1)"
    _sql_rc=$?
    if [ "$_sql_rc" -ne 0 ]; then
        # The whole point: say what to do about it — FIRST, and on stdout with
        # the error. On stderr after the output, an agent capturing stdout never
        # saw the remedy, and one capturing both read exapump's generic "Hint:"
        # before the real fix. When the kit has a specific remedy, the generic
        # hint is noise and is dropped.
        _sql_remedy="$(exakit_db_error_remedy "$_sql_out" "$_sql_text")"
        if [ -n "$_sql_remedy" ]; then
            printf '%s\n' "$_sql_remedy" | sed 's/^/! /'
            printf '%s\n' "$_sql_out" | grep -v '^[[:space:]]*Hint: '
        else
            printf '%s\n' "$_sql_out"
        fi
        return "$_sql_rc"
    fi
    printf '%s\n' "$_sql_out"
    return 0
}

# cmd_whats_new [version] — what changed, for this kit or a named one.
#
# Defaults to the version actually installed rather than the newest section in the
# file: a user on 0.2.0 asking what is new wants their own release notes, not a
# preview of one they do not have yet.
cmd_whats_new() {
    _cwn_version="${1:-}"
    if [ -z "$_cwn_version" ]; then
        _cwn_version="$(exakit_kit_bundled_version 2>/dev/null || true)"
        [ -n "$_cwn_version" ] || _cwn_version="$(manifest_get kit.version 2>/dev/null || true)"
    fi
    [ -n "$_cwn_version" ] || die "Could not tell which kit version this is. Name one: exakit whats-new 0.2.0"
    if ! exakit_print_whats_new "$_cwn_version" "What's new in $_cwn_version"; then
        _cwn_root="$(exakit_repo_root 2>/dev/null || true)"
        if [ -n "$_cwn_root" ] && exakit_whats_new_file "$_cwn_root" >/dev/null 2>&1; then
            info "No notes for $_cwn_version. Versions covered:"
            exakit_whats_new_versions "$_cwn_root" 2>/dev/null | sed 's/^/      /'
        else
            info "This kit copy does not carry setup/whats-new.json."
        fi
    fi
}

# cmd_catalog [search] - the searchable command surface, rendered from the same
# help documents every other screen uses (setup/help/*.json). --json keeps its
# original shape: one object whose "commands" array carries tool/command/
# options/description, so an agent can discover the CLI without parsing ANSI.
cmd_catalog() {
    _cat_json=0
    _cat_args=""
    for _cat_arg in "$@"; do
        case "$_cat_arg" in
            --json|-j) _cat_json=1 ;;
            *) _cat_args="${_cat_args:+$_cat_args }$_cat_arg" ;;
        esac
    done
    _search="$(printf '%s' "$_cat_args" | tr '[:upper:]' '[:lower:]')"
    if [ "$_cat_json" -eq 1 ]; then
        exakit_can_run_python || die "python3 is needed for --json."
        exakit_help_render json "$_search"
        return $?
    fi
    exakit_help_render catalog "$_search"
}

# _with_notice <command...> - run a command, then let the update notice speak.
# The command's own exit status is preserved: version news must never change what
# `exakit mcp-doctor` (or anything else) reports to a script.
#
# Only the commands below carry it. `version` and `update` render version state
# themselves, uninstall is a farewell, and help/catalog are reference screens
# that stay instant and clean.
_with_notice() {
    "$@"
    _wn_rc=$?
    exakit_notice_after_command || true
    return $_wn_rc
}

# `exakit <thing> --help` answers from the help documents - the same single
# source of truth `exakit catalog` renders - so every subcommand AND every
# component supports the flag without growing its own help text. Placed before
# the dispatch: the answer must not depend on which command it is.
#
# `sql` is excluded on purpose: its argument is arbitrary SQL text, and a
# statement that happens to contain --help is a query, not a request for help.
#
# A leading help flag is excluded too: `exakit --help --json` is the help
# COMMAND with an option, not a request for a topic literally named "--help".
# It used to fall in here, be rendered as a command page for that topic, and
# print grep's usage block instead of the JSON document an agent asked for.
case "${1:-}" in
    help|--help|-h) _help_skip=1 ;;
    *)              _help_skip=0 ;;
esac
if [ $# -ge 2 ] && [ "$1" != "sql" ] && [ "$_help_skip" -eq 0 ]; then
    for _help_arg in "$@"; do
        case "$_help_arg" in
            --help|-h)
                _help_topic="$1"
                if exakit_help_is_id "$_help_topic"; then
                    exakit_help_render component "$_help_topic"
                else
                    exakit_help_render command "$_help_topic"
                fi
                exit $?
                ;;
        esac
    done
fi

# _exakit_refuse_unknown_options <command> <allowed csv> <args...> — the ONE
# rule for options the command does not take: exit 2, nothing runs. Twelve
# commands used to accept any flag and do their work anyway: `exakit stop
# --bogus` stopped the database, `skills-install --bogus` installed, `help
# --bogus` handed the flag to grep. Bad input is refused before the command
# starts, the way status and sql already did. Commands with their own option
# parser (sql, status, version, logs, autostart, data-load, repair-runtime,
# mcp-setup, mcp-status, marketplace, uninstall) keep it; this covers the rest.
_exakit_refuse_unknown_options() {
    _ruo_cmd="$1"; _ruo_allowed="$2"; shift 2
    for _ruo_arg in "$@"; do
        case "$_ruo_arg" in
            -*)
                case ",$_ruo_allowed," in
                    *",$_ruo_arg,"*) ;;
                    *) if [ -n "$_ruo_allowed" ]; then
                           reject "Unknown option '$_ruo_arg' for $_ruo_cmd (supported: $(printf '%s' "$_ruo_allowed" | tr ',' ' '))."
                       else
                           reject "Unknown option '$_ruo_arg' for $_ruo_cmd (it takes none)."
                       fi ;;
                esac ;;
        esac
    done
}

# EXAKIT_REFUSAL_JSON — did this caller ask for a machine answer?
#
# Set once, here, so that reject() and the unknown-command arm below can honour
# --json on the paths that REFUSE, not only on the paths that succeed. `sql` is
# excluded for the same reason it is excluded from the universal --help hook:
# its argument is arbitrary SQL text, and a statement containing --json is a
# query. It carries its own --json parsing and its own _sql_reject anyway.
case "${1:-}" in
    sql) : ;;
    *)
        for _rj_arg in "$@"; do
            case "$_rj_arg" in
                --json|-j) EXAKIT_REFUSAL_JSON=1; export EXAKIT_REFUSAL_JSON; break ;;
            esac
        done
        ;;
esac

# State QUERIES are read-only by contract: no probe they run - however it
# fails - may write the .last-failure note that status --json then reports as
# an install failure forever. exakit_note_failure honours the flag, and every
# child process inherits it. (A separate case, not a ;;& fall-through arm:
# that is bash 4.0 syntax and this file must run on the 3.2 macOS ships.)
case "${1:-help}" in
    status|version|--version|-v|info|mcp-status|mcp-doctor|skills|catalog|logs|help|--help|-h|whats-new)
        export EXAKIT_READONLY_QUERY=1 ;;
esac

case "${1:-help}" in
    preflight) shift; _exakit_refuse_unknown_options preflight "" "$@"; _with_notice preflight_report ;;
    status)   shift
              case "${1:-}" in
                  --json|-j) cmd_status --json ;;
                  *) _with_notice cmd_status "$@" ;;
              esac ;;
    version|--version|-v)  shift; cmd_version "$@" ;;
    # --plan/--backup/--apply are the Personal MAJOR-upgrade route the header
    # and the macOS quickstart have always named — and this guard refused
    # them, so the documented migration path was unreachable from the CLI
    # while personal_update implemented it in full.
    update) shift; _exakit_refuse_unknown_options update "--yes,-y,--plan,--backup,--apply" "$@"; cmd_update "$@" ;;
    info)     shift
              _exakit_refuse_unknown_options info "--json,-j" "$@"
              case "${1:-}" in
                  --json|-j) cmd_info_json ;;
                  # The --json form was reachable only from `exakit help`, so a
                  # reader looking at these details had no way to learn the
                  # machine-readable one exists. The hint lives here rather than
                  # in connection_panel because the install ends with that same
                  # panel, and someone finishing an install is not looking for a
                  # JSON dump.
                  # No trailing "Machine-readable:" sentence -- the Manifest
                  # row inside the panel names `exakit info --json` where the
                  # reader is already looking.
                  *) _with_notice cmd_info ;;
              esac ;;
    guide)    shift; _exakit_refuse_unknown_options guide "" "$@"; _with_notice exakit_guide ;;
    start)    shift; _exakit_refuse_unknown_options start "" "$@"; _with_notice cmd_start ;;
    stop)     shift; _exakit_refuse_unknown_options stop "" "$@"; _with_notice cmd_stop ;;
    repair-runtime) shift; cmd_repair_runtime "$@" ;;
    migrate)  shift; cmd_migrate "$@" ;;
    autostart) shift; _with_notice cmd_autostart "$@" ;;
    data-load) shift; _with_notice cmd_data_load "${1:-}" ;;
    mcp-setup) shift; _with_notice cmd_mcp_setup "$@" ;;
    mcp-doctor) shift; _exakit_refuse_unknown_options mcp-doctor "--json,-j" "$@"; _with_notice cmd_mcp_doctor "$@" ;;
    mcp-remove) shift; _exakit_refuse_unknown_options mcp-remove "" "$@"; _with_notice cmd_mcp_remove "$@" ;;
    mcp-status) shift; _with_notice cmd_mcp_status "$@" ;;
    skills)   shift
              _exakit_refuse_unknown_options skills "--json,-j" "$@"
              case "${1:-}" in
                  --json|-j) cmd_skills --json ;;
                  *) _with_notice cmd_skills ;;
              esac ;;
    skills-install) shift; _exakit_refuse_unknown_options skills-install "" "$@"; _with_notice cmd_skills_install ;;
    marketplace) shift; _with_notice cmd_marketplace "$@" ;;
    upgrade-kit2)  cmd_kit2_script upgrade-kit2.sh ;;
    rollback-kit2) cmd_kit2_script rollback-kit2.sh ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    whats-new) shift; _exakit_refuse_unknown_options whats-new "" "$@"; cmd_whats_new "${1:-}" ;;
    sql)      shift; cmd_sql "$@" ;;
    logs)     shift; cmd_logs "$@" ;;
    catalog)  shift; _exakit_refuse_unknown_options catalog "--json,-j" "$@"; cmd_catalog "$@" ;;
    help|-h|--help) shift; _exakit_refuse_unknown_options help "--json,-j,--all,-a" "$@"; usage "$@" ;;
    *) # A component name on its own is a reasonable thing to type, and the
       # answer is its page - not "unknown command" followed by the whole menu.
       if exakit_help_is_id "${1}"; then
           exakit_help_render component "${1}"
       elif [ "${EXAKIT_REFUSAL_JSON:-0}" = "1" ]; then
           # One object on stdout, and the whole usage screen NOT dumped into
           # the middle of it.
           printf '{"ok": false, "error": "%s", "remedy": "exakit catalog --json", "rejected": true}\n' \
               "$(_exakit_json_string "Unknown command '${1}'.")"
           exit 2
       else
           echo "exakit: unknown command '${1}'" >&2
           usage >&2
           exit 2
       fi ;;
esac
