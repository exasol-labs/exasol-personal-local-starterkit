# cmd_kit2_script <script> — run one of the kit's own upgrade scripts from the
# installed kit copy, so nobody has to know or type its path.
cmd_kit2_script() {
    _k2_root="$(exakit_repo_root)" || die "Could not locate the kit's upgrade/ scripts."
    _k2_script="$_k2_root/upgrade/$1"
    [ -f "$_k2_script" ] || die "$1 is not part of this kit build."
    bash "$_k2_script"
}

# cmd_logs [target] [-f|--follow] [--lines N] [--path] — every log the kit can
# show, in one place. No target lists what is available; a target tails it.
cmd_logs() {
    _log_target=""
    _log_follow=0
    _log_lines=200
    _log_path_only=0
    _log_json=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--follow) _log_follow=1 ;;
            --path)      _log_path_only=1 ;;
            --json|-j)   _log_json=1 ;;
            --lines)     shift; _log_lines="${1:-200}" ;;
            -n)          shift; _log_lines="${1:-200}" ;;
            -*)          reject "Unknown option '$1' for logs (supported: -f/--follow, --lines N, --path, --json)." ;;
            *)           [ -n "$_log_target" ] && reject "Only one log target at a time (got '$_log_target' and '$1')."
                         _log_target="$1" ;;
        esac
        shift
    done
    case "$_log_lines" in
        ''|*[!0-9]*) reject "--lines needs a number (got '$_log_lines')." ;;
    esac
    if [ -z "$_log_target" ]; then
        if [ "$_log_json" -eq 1 ]; then
            exakit_logs_overview_json || die "python3 is needed for --json."
            return 0
        fi
        exakit_logs_overview
        return 0
    fi
    [ "$_log_json" -eq 1 ] && \
        reject "--json lists the log targets; it does not apply to one target's contents. Use: exakit logs --json, then exakit logs $_log_target --path"
    exakit_logs_show "$_log_target" "$_log_follow" "$_log_lines" "$_log_path_only"
}

cmd_data_load() {
    _require_install
    # data-load takes either --force or a PATH. A path names what to load
    # without walking the menu to type it in -- and a folder path is the bulk
    # load: every CSV/Parquet/JSON file in it, one table each.
    _dl_force=""
    _dl_path=""
    case "${1:-}" in
        "")      ;;
        --force) _dl_force="--force" ;;
        -*)      reject "Unknown option '$1' for data-load (pass --force, or a file or folder path)." ;;
        *)       _dl_path="$1" ;;
    esac
    command -v exakit_load_sample_data >/dev/null 2>&1 || \
        die "The exapump data-loading module is not available in this kit build."
    if [ -n "$_dl_path" ]; then
        _dl_norm="$(exakit_normalize_path "$_dl_path")"
        [ -e "$_dl_norm" ] || die "No such file or folder: $_dl_path"
        # Naming a path IS choosing the local-file row, which is exactly what
        # EXAKIT_DATA_FILE already means -- so one contract covers the argument
        # and the variable, and the menu never draws for either.
        EXAKIT_DATA_FILE="$_dl_norm"
        export EXAKIT_DATA_FILE
    fi
    exakit_init_logging
    # Loading data needs a database that answers — a stopped one used to make
    # the dataset checks silently trust the manifest and the load itself fail.
    exakit_ensure_runtime_running deploy
    if [ -n "$_dl_force" ]; then
        _kit_root="$(exakit_repo_root)" || \
            die "Could not find the kit's sql/ and data/ files to load."
        # EXAKIT_DATASETS names WHICH datasets; --force says "replace them even
        # though they are already there". They compose. --force used to ignore
        # the variable outright and reload the bundled sample alone, so an
        # unattended `EXAKIT_DATASETS=tpch,energy,weather exakit data-load
        # --force` silently restored one of the three and reported success —
        # with no way at all to reload the others without a full re-install.
        if [ -n "${EXAKIT_DATASETS:-}" ]; then
            _dl_known=" $(exakit_bundled_datasets | cut -d'|' -f1 | tr '\n' ' ') "
            _dl_any=0
            _dl_failed=0
            for _dl_id in $(printf '%s' "$EXAKIT_DATASETS" | tr ',' ' '); do
                case "$_dl_known" in
                    *" $_dl_id "*)
                        _dl_any=1
                        info "Reloading dataset '$_dl_id' (EXAKIT_DATASETS, --force)"
                        exakit_load_dataset "$_kit_root" "$_dl_id" "--force" || _dl_failed=1
                        ;;
                    *)
                        warn "Unknown dataset id '$_dl_id' in EXAKIT_DATASETS (available:$(printf '%s' "$_dl_known" | sed 's/ *$//'))."
                        ;;
                esac
            done
            [ "$_dl_any" -eq 1 ] || \
                die "EXAKIT_DATASETS='$EXAKIT_DATASETS' matched no bundled dataset — nothing was reloaded."
            return "$_dl_failed"
        fi
        info "Reloading the bundled sample dataset (log: ${EXAKIT_LOG_FILE:-none})"
        exakit_load_sample_data "$_kit_root" "--force"
    elif [ -n "${EXAKIT_DATASETS:-}" ] && [ -z "${EXAKIT_DATA_FILE:-}" ]; then
        # Named datasets, unattended: load the ones not yet loaded, say so for
        # the rest, exit 0. This used to fall through to the interactive menu,
        # whose non-interactive default row is the local file — so "load
        # weather" on a machine that already had it ended in "please enter a
        # file" and exit 1.
        _kit_root="$(exakit_repo_root)" || \
            die "Could not find the kit's sql/ and data/ files to load."
        _dl_known=" $(exakit_bundled_datasets | cut -d'|' -f1 | tr '\n' ' ') "
        _dl_pending=" $(exakit_pending_datasets 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ') "
        _dl_any=0
        _dl_failed=0
        for _dl_id in $(printf '%s' "$EXAKIT_DATASETS" | tr ',' ' '); do
            case "$_dl_known" in
                *" $_dl_id "*)
                    _dl_any=1
                    case "$_dl_pending" in
                        *" $_dl_id "*)
                            info "Loading dataset '$_dl_id' (EXAKIT_DATASETS)."
                            exakit_load_dataset "$_kit_root" "$_dl_id" || _dl_failed=1
                            ;;
                        *) ok "Dataset '$_dl_id' is already loaded — nothing to do (replace it with: exakit data-load --force, which drops and rebuilds its tables)" ;;
                    esac
                    ;;
                *)
                    warn "Unknown dataset id '$_dl_id' in EXAKIT_DATASETS (available:$(printf '%s' "$_dl_known" | sed 's/ *$//'))."
                    ;;
            esac
        done
        [ "$_dl_any" -eq 1 ] || \
            die "EXAKIT_DATASETS='$EXAKIT_DATASETS' matched no bundled dataset — nothing was loaded."
        return "$_dl_failed"
    else
        command -v exakit_data_load_menu >/dev/null 2>&1 || \
            die "The exapump data-loading module is not available in this kit build."
        exakit_data_load_menu
    fi
}

cmd_mcp_setup() {
    # Options are refused, not ignored. `exakit mcp-setup --clients vscode_copilot`
    # ran the plain setup, said "already connected" and exited 0, so the agent
    # that typed it believed the client had been re-applied. Clients are named
    # through EXAKIT_MCP_CLIENTS, and the message says so. Exit 2 like every
    # other command's unknown option.
    for _cms_arg in "$@"; do
        case "$_cms_arg" in
            -*) reject "Unknown option '$_cms_arg' for mcp-setup (it takes none; name clients with EXAKIT_MCP_CLIENTS=claude,codex exakit mcp-setup)." ;;
            *)  reject "mcp-setup takes no arguments; name clients with EXAKIT_MCP_CLIENTS=$_cms_arg exakit mcp-setup" ;;
        esac
    done
    _require_install
    exakit_init_logging
    exakit_mcp_setup || die "Could not complete MCP client setup"
}

# cmd_mcp_doctor [--json] [clients] — diagnostics, with the DIAGNOSIS ORDER a
# diagnostician uses: is the database even running, before anything that needs
# it? Without that check the first downstream failure (creating the read-only
# user against a dead port) used to headline as "MCP user is broken" and send
# people at the MCP config — the wrong subsystem entirely. Exit 3 mirrors
# `exakit status`, so agents branch the same way on both.
#
# Doctor also REPAIRS what it finds. There is no separate repair command: being
# told a client is broken and then handed a second command to type is the tool
# asking the user to do the obvious next step by hand.
# cmd_mcp_remove <client...> — take the kit's managed entries out of the named
# clients and forget them. The remedy doctor prints for a client that is no
# longer on the machine ("remove the stale entry with 'exakit mcp-remove
# <client>'") named this command before it existed; the module has always had
# the operation. Clients only, by name; the server entries are the kit's.
cmd_mcp_remove() {
    [ "$#" -gt 0 ] || reject "Name the client(s) to remove the kit's MCP entries from: exakit mcp-remove cursor (see: exakit mcp-status)"
    for _cmr_arg in "$@"; do
        case "$_cmr_arg" in
            all) reject "mcp-remove takes client names, not 'all' — the full removal is: exakit uninstall" ;;
        esac
    done
    _require_install
    exakit_init_logging
    exakit_mcp_operation uninstall "$@" || die "Could not remove the MCP entries"
}

cmd_mcp_doctor() {
    # Parse BEFORE the install check: the check's own answer has to honour
    # --json, and it has to exit 4 rather than 1. Reversing these two lines is
    # what made `mcp-doctor --json` print nothing on a machine with no install.
    _cmd_json=0
    _cmd_rest=""
    for _cmd_arg in "$@"; do
        case "$_cmd_arg" in
            --json|-j) _cmd_json=1 ;;
            *) _cmd_rest="${_cmd_rest:+$_cmd_rest }$_cmd_arg" ;;
        esac
    done
    [ -f "$EXAKIT_MANIFEST" ] || _not_installed_answer "$_cmd_json"
    if [ -z "$(_runtime_type)" ]; then
        # A manifest with no runtime is an INCOMPLETE install, not "not
        # installed". This arm used to answer installed: false / exit 4 for the
        # exact machine state `status --json` calls installed: true / exit 3 —
        # so an agent cross-checking the two state queries AGENTS.md groups
        # under one contract got opposite answers to "is the kit installed?".
        if [ "$_cmd_json" -eq 1 ]; then
            printf '{"installed": true, "status": "no database", "database": "not installed", "remedy": "%s", "remedy_hint": "no runtime is recorded yet; the installer resumes at the unfinished step"}\n' \
                "$(exakit_install_command)"
        else
            warn "No runtime is recorded in the manifest yet, so there is no database to diagnose against."
            info "Finish the install first: $(exakit_install_command)"
        fi
        exit 3
    fi
    exakit_init_logging
    if ! exakit_runtime_is_running; then
        if [ "$_cmd_json" -eq 1 ]; then
            # Same three keys as every other --json answer from a state query
            # (installed / status / remedy), so one parser handles all of them.
            # `database` is kept for callers written against the older shape.
            #
            # "stopped", THE SAME WORD `status --json` USES. AGENTS.md promises
            # the five state queries "agree with each other on the status
            # vocabulary", and this emitter and info's said "database not
            # running" where status said "stopped" - one state, three emitters,
            # two words, so `if d["status"] == "stopped"` was correct for one
            # command and silently false for the other two. The sentence lives
            # on in `database` and in the prose below, where it reads well;
            # `status` is the machine field and now has one value per state.
            printf '{"installed": true, "status": "stopped", "database": "not running", "remedy": "%s"}\n' \
                "$(exakit_runtime_remedy)"
        else
            warn "The database is not running — fix that first: $(exakit_runtime_remedy)"
            info "MCP diagnostics need a live database (the read-only user and its grants are checked against it)."
        fi
        exit 3
    fi
    if [ "$_cmd_json" -eq 1 ]; then
        EXAKIT_MCP_RESULT_JSON=1
        export EXAKIT_MCP_RESULT_JSON
    fi
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    # A clean run, or one whose only findings are warnings repair cannot act
    # on, ends here. A run that exited 0 but reported a repairable WARNING - a
    # loosened file mode is the common one - goes on to the repair below: it
    # used to stop here, so doctor said "repairs drift", printed the warning,
    # and left the mode at 644.
    if [ "$_cmd_rc" = 0 ] && [ "${EXAKIT_MCP_LAST_REPAIRABLE:-0}" != 1 ]; then
        return 0
    fi
    # Anything other than "ran and reported" is the subsystem failing to run at
    # all, which is the only case that deserves the word "could not".
    [ "$_cmd_rc" = 0 ] || [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"

    # The diagnosis found something. Repair it here rather than printing a
    # second command to type: someone runs mcp-doctor to be told their clients
    # are fine, and being handed `exakit mcp-repair` is the tool asking the user
    # to do the obvious next step by hand. mcp-setup ADDS clients; mcp-doctor
    # checks the ones already configured and puts them right.
    #
    # --json callers get the diagnosis unchanged: a machine parsing the report
    # must not have a second document appended to it.
    if [ "$_cmd_json" -eq 1 ]; then
        [ "$_cmd_rc" = 0 ] && exit 0
        exit 1
    fi
    # The repair runs QUIETLY. Its own summary panel repeats the client list and
    # the operation header the diagnosis above just printed, and in the common
    # case it has nothing to say beyond "no repair was needed" - three
    # near-identical reports for one question, where the reader is trying to
    # work out what actually happened. One line is the whole content.
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    _cmd_repair_out="$(exakit_mcp_operation repair $_cmd_rest 2>&1)"
    _cmd_repair_rc=$?
    if [ "$_cmd_repair_rc" != 0 ] && [ "$_cmd_repair_rc" != 2 ]; then
        printf '%s\n' "$_cmd_repair_out"
        die "Could not repair the managed MCP configuration"
    fi

    case "$_cmd_repair_out" in
        *no_change*|*"already consistent"*)
            # Nothing was rewritten, so a re-check would reprint the report
            # above word for word. Say what happened and stop.
            info "Nothing to repair: the managed client config is already consistent."
            warn "The findings above are not config drift, so they remain."
            exit 1
            ;;
    esac

    # Something WAS rewritten, so the report above is now out of date. Re-check
    # once - once only: a repair that did not take is a fault to report, not a
    # loop to run - and let that reading be the last word.
    info "Repaired the managed client config — re-checking"
    printf '\n'
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation doctor $_cmd_rest
    _cmd_rc=$?
    # A repair that took also retires the failure note the fault may have left:
    # `.last-failure` kept saying "Could not read managed MCP state" after the
    # config was put right, while status --json said null.
    [ "$_cmd_rc" = 0 ] && { exakit_clear_failure_note; ok "Everything the repair could fix is fixed."; return 0; }
    [ "$_cmd_rc" = 2 ] || die "Could not run MCP diagnostics"
    warn "Some findings are not config drift and remain — see the notes above."
    exit 1
}

cmd_mcp_status() {
    # --json is read BEFORE the install check, so the check answers in the shape
    # the caller asked for. The other order printed no JSON at all on a machine
    # with nothing installed - the one state a parser most needs an answer for.
    _ms_json=0
    for _ms_pre in "$@"; do
        case "$_ms_pre" in --json|-j) _ms_json=1 ;; esac
    done
    # AND THE REFUSAL COMES FIRST TOO, for the same reason the --json read does.
    # This validation used to sit AFTER _require_install, so on a machine with
    # nothing installed `exakit mcp-status --bogus` answered 4 ("not
    # installed") for what is bad input - the one command out of twelve that
    # did. AGENTS.md is unambiguous: bad input exits 2, for "an unknown option
    # to any command", and whether the kit happens to be installed does not
    # change whether the option exists.
    for _ms_pre in "$@"; do
        case "$_ms_pre" in
            --json|-j) ;;
            -*) reject "Unknown option '$_ms_pre' for mcp-status (supported: --json)." ;;
        esac
    done
    _require_install "$_ms_json"
    exakit_init_logging
    _ms_rest=""
    for _ms_arg in "$@"; do
        case "$_ms_arg" in
            # The JSON form existed behind an env var the doctor sets for
            # itself; here "--json" was read as a client name.
            --json|-j) EXAKIT_MCP_RESULT_JSON=1; export EXAKIT_MCP_RESULT_JSON ;;
            -*) reject "Unknown option '$_ms_arg' for mcp-status (supported: --json)." ;;
            *) _ms_rest="$_ms_rest $_ms_arg" ;;
        esac
    done
    # shellcheck disable=SC2086 — client names are single tokens by contract
    exakit_mcp_operation status $_ms_rest
    _cmd_rc=$?
    [ "$_cmd_rc" = 0 ] && return 0
    [ "$_cmd_rc" = 2 ] && exit 1
    die "Could not read managed MCP state"
}

