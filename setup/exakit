#!/usr/bin/env bash
# exakit — lifecycle helper for the Exasol Personal Local Starter Kit.
#
# usage: exakit <command>
#
#   preflight           check this machine's requirements, install nothing
#   status              show what is installed and whether it is healthy
#   version             kit source, install date, and every component's
#                       installed version beside the advertised one
#   update [what] [--yes]
#                       apply the advertised versions without deleting database data.
#                       A runtime change stops the database, so on a terminal it is
#                       offered ("stop the database and update it now?") and applied
#                       on yes; without a terminal it is deferred unless --yes (or
#                       EXAKIT_CONFIRM_RUNTIME_UPDATE=1) says otherwise
#                       Personal major upgrades support --plan, --backup, --apply
#                       (macOS, Linux and WSL only - the Windows CLI has no
#                       staged route and says so if you pass one of them)
#   info [--json]       print the connection details panel; --json prints the
#                       install record (manifest.json) plus the state keys
#                       installed / status / remedy / skills, nothing else
#   guide               friendly walkthrough: connect AI clients (MCP), SQL
#                       clients (DBeaver, DbVisualizer), and Python (pyexasol)
#   start               start the local database and every add-on service
#   stop                stop them again
#   repair-runtime [--yes]  rebuild a database that cannot be started (the
#                       launcher reports it interrupted and every start fails);
#                       DESTRUCTIVE — the deployment is replaced and its data
#                       is gone, bundled datasets are reloaded afterwards
#   migrate docker-nano [--container NAME] [--engine docker|podman]
#                       [--dsn HOST:PORT] [--user USER] [--password-file PATH]
#                       [--yes] [--json]
#                       copy the tables of an older kit's container database
#                       (Exasol Nano in Docker or Podman) into this database,
#                       for a machine that skipped the offer at install time or
#                       never got it; the kit's own sample data is left out and
#                       the container is never removed
#   autostart           whether everything comes back after a restart; shows
#                       the current state and asks whether to change it
#   data-load [--force|<path>]
#                       open focused data loading options; a file path loads that
#                       file, a FOLDER path bulk-loads every CSV/Parquet/JSON file
#                       in it (one table each); --force REPLACES bundled datasets
#   sql '<statement>' [--write]
#                       run one SQL statement and translate the error into a
#                       remedy; reads only unless --write. Uses the ADMIN
#                       connection (the read-only boundary is the MCP user)
#   mcp-setup           permanently configure MCP in supported AI clients
#   mcp-doctor          check the configured MCP clients, repair what has
#                       drifted, then re-check (there is no separate repair)
#   mcp-status          show managed MCP state for the supported AI clients
#   mcp-remove <client> [<client>...]
#                       take the kit's managed MCP entries out of the named
#                       clients and forget them, so mcp-doctor stops reporting
#                       a client that is no longer on this machine
#   skills [--json]     list the kit's AI skills and whether each one has
#                       reached the agents' discovery folders
#   skills-install      install the kit's AI skills for CLI agents
#                       (~/.claude/skills, ~/.agents/skills)
#   marketplace         browse optional add-ons (dash-server, ...) and install
#                       the ones you select; installed add-ons then update
#                       through `exakit update` like every other component
#   upgrade-kit2        add the Kit 2 trust assets (Trusted AI Workflow add-on)
#                       on top of this install; nothing is reinstalled
#   rollback-kit2       remove exactly what upgrade-kit2 added; the database and
#                       every Kit 1 component stay untouched
#   uninstall [--yes] [--dry-run]
#                       pick what to remove — components, add-ons, or
#                       EVERYTHING (database + data, MCP client configs,
#                       skills, exapump, pyexasol, the kit home and the CLI
#                       binaries) — with a summary and a typed confirmation.
#                       --dry-run previews the full plan; --yes is the
#                       scripted full uninstall
#   whats-new [version] what changed in this kit version
#   logs [target] [--json]
#                       every log the kit can show; no target lists them.
#                       --json lists the targets and their paths machine-readably
#                       (-f follows, --lines N, --path prints the path)
#   catalog [search] [--json]
#                       browse/search every exakit, exapump & exasol command;
#                       --json prints the whole command surface as an object
#   help                this text
#
# Installed to ~/.local/bin by the setup scripts; also runs straight from a
# repo checkout (setup/exakit).

set -u
set -o pipefail

# --- locate the kit's lib directory ----------------------------------------
_script_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$_script_dir/lib/common.sh" ]; then
    _lib_dir="$_script_dir/lib"
elif [ -f "${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib/common.sh" ]; then
    _lib_dir="${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib"
else
    # Name the path actually searched, not the default. With EXAKIT_HOME set this
    # message used to send the reader to ~/.exasol-starter-kit/kit while the code
    # had looked somewhere else entirely.
    # No kit here is "not installed": exit 4, and one JSON object when --json
    # was asked for, the same shape every state query answers with. This used
    # to be prose and exit 1, so a parser pointed at a relocated EXAKIT_HOME
    # got neither the status nor the remedy it was promised.
    _no_lib_remedy="re-run the installer (curl -fsSL https://raw.githubusercontent.com/exasol-labs/exasol-personal-local-starterkit/main/install.sh | sh)${EXAKIT_HOME:+; or point EXAKIT_HOME at an install that has kit/setup/lib}"
    # AN INTERRUPTED UPDATE IS A DIFFERENT PROBLEM WITH A MUCH CHEAPER ANSWER,
    # and this is the only code left able to say so. `exakit update` renames
    # the kit aside before renaming the new one in; killed between the two, the
    # machine has a kit.backup-<ts> and no kit, and every subcommand lands
    # here. Telling that user to re-download and reinstall the kit would be
    # both slower and more destructive than the single rename that fixes it.
    #
    # The marker is what the updater leaves; the directory scan is the fallback
    # for a kit updated by a version of this file that did not write one.
    _no_lib_home="${EXAKIT_HOME:-$HOME/.exasol-starter-kit}"
    _no_lib_backup=""
    if [ -f "$_no_lib_home/.update-in-progress" ]; then
        _no_lib_backup="$(cat "$_no_lib_home/.update-in-progress" 2>/dev/null || true)"
    fi
    if [ -z "$_no_lib_backup" ] || [ ! -d "$_no_lib_backup" ]; then
        _no_lib_backup=""
        for _no_lib_cand in "$_no_lib_home"/kit.backup-*; do
            [ -d "$_no_lib_cand/setup/lib" ] || continue
            _no_lib_backup="$_no_lib_cand"
        done
    fi
    if [ -n "$_no_lib_backup" ] && [ ! -d "$_no_lib_home/kit" ]; then
        _no_lib_remedy="mv '$_no_lib_backup' '$_no_lib_home/kit'"
    fi
    for _no_lib_arg in "$@"; do
        case "$_no_lib_arg" in
            --json|-j)
                printf '{"installed": false, "status": "not installed", "remedy": "%s", "error": "no kit library at %s/lib or %s/kit/setup/lib"}\n' \
                    "$_no_lib_remedy" "$_script_dir" "${EXAKIT_HOME:-$HOME/.exasol-starter-kit}"
                exit 4 ;;
        esac
    done
    if [ -n "$_no_lib_backup" ] && [ ! -d "$_no_lib_home/kit" ]; then
        echo "exakit: an update was interrupted before the new kit was put in place." >&2
        echo "exakit: your previous kit copy is still here, and nothing else was touched - the database, its data and your credentials are untouched." >&2
        echo "exakit: put it back with one command:" >&2
        echo "  $_no_lib_remedy" >&2
        echo "exakit: then run 'exakit update' again." >&2
        exit 4
    fi
    echo "exakit: cannot find the kit library (looked in $_script_dir/lib and ${EXAKIT_HOME:-$HOME/.exasol-starter-kit}/kit/setup/lib)" >&2
    echo "exakit: if EXAKIT_HOME is set, it must point at an install that has kit/setup/lib; otherwise re-run the installer." >&2
    exit 4
fi

. "$_lib_dir/common.sh"
. "$_lib_dir/detect.sh"
. "$_lib_dir/runtime-personal.sh"
[ -f "$_lib_dir/help.sh" ] && . "$_lib_dir/help.sh"
[ -f "$_lib_dir/exapump.sh" ] && . "$_lib_dir/exapump.sh"
# The crossing module: `exakit migrate docker-nano` is its after-the-install
# road, and `exakit status` reads what it remembered about the old database.
[ -f "$_lib_dir/legacy-crossing.sh" ] && . "$_lib_dir/legacy-crossing.sh"
[ -f "$_lib_dir/mcp.sh" ] && . "$_lib_dir/mcp.sh"
# pyexasol is an update target of its own (and its own repair command), so the
# CLI needs the module even though it takes no part in the runtime commands.
[ -f "$_lib_dir/pyexasol.sh" ] && . "$_lib_dir/pyexasol.sh"
# Marketplace add-on modules: the CLI is where they are installed (exakit
# marketplace) and updated (exakit update <addon>), so it loads every module
# it ships. A missing file only makes the marketplace row unavailable.
[ -f "$_lib_dir/dash-server.sh" ] && . "$_lib_dir/dash-server.sh"
[ -f "$_lib_dir/dbt-exasol.sh" ] && . "$_lib_dir/dbt-exasol.sh"
[ -f "$_lib_dir/exasol-vscode.sh" ] && . "$_lib_dir/exasol-vscode.sh"
[ -f "$_lib_dir/json-tables.sh" ] && . "$_lib_dir/json-tables.sh"
[ -f "$_lib_dir/exasol-scheduler.sh" ] && . "$_lib_dir/exasol-scheduler.sh"

_runtime_type() {
    manifest_get runtime.type 2>/dev/null
}

# _require_install [json:0|1] — with 1, a caller that was ASKED for JSON
# answers in JSON even for "not installed": a bare die left stdout empty and a
# human error card on stderr, so the parser on the other end read "Expecting
# value: line 1 column 1" on exactly the path where structured signal matters.
_require_install() {
    _ri_json="${1:-0}"
    # NOTHING IS WRITTEN BEFORE THE MANIFEST CHECK. This used to call
    # exakit_init_logging first and then `die`, so `exakit sql 'SELECT 1'` on a
    # machine with NO install created ~/.exasol-starter-kit/, a logs/ tree, and
    # a .last-failure note — which `status --json` then reported as
    # `last_failure` ("a step of your install did not finish") forever, and
    # `logs --json` listed a log file the probe itself had just made. A refused
    # QUERY is bad input, not a failed install step. The same exit codes every
    # state query uses: 4 no install record, 3 an install with no runtime yet.
    if [ ! -f "$EXAKIT_MANIFEST" ]; then
        if [ "$_ri_json" = "1" ]; then
            # A SUPERSET OF THE OTHER FOUR, not a different shape. AGENTS.md
            # promises "one shape covers all of them" for the five state
            # queries, and mcp-status is the only one whose not-installed
            # answer comes from here - so it alone lacked `manifest` and
            # `reason`, and a parser reading `reason` for the explanation got a
            # KeyError on exactly one of the five. `ok` and `error` stay for
            # the non-state-query callers of this function, which is why this
            # is additive rather than a swap.
            printf '{"ok": false, "installed": false, "status": "not installed", "manifest": "%s", "reason": "no install record", "error": "no installation found", "remedy": "%s"}\n' \
                "$EXAKIT_MANIFEST" "$(exakit_install_command)"
            exit 4
        fi
        printf '\n  %s%s %sNo installation found. Run the installer first: %s%s\n' \
            "${UI_ERR:-}" "${UI_CROSS:-[x]}" "${UI_BOLD:-}" "$(exakit_install_command)" "${UI_RESET:-}" >&2
        exit 4
    fi
    # An install record exists, so from here a log file belongs to a real kit.
    exakit_init_logging 2>/dev/null || true
    if [ -z "$(_runtime_type)" ]; then
        # `status --json` answers installed: true / status "no database" /
        # exit 3 for this same machine state. Two state queries may not
        # disagree on either, so this gate speaks the same vocabulary.
        if [ "$_ri_json" = "1" ]; then
            printf '{"ok": false, "installed": true, "status": "no database", "error": "no runtime recorded in the manifest yet", "remedy": "%s", "remedy_hint": "the installer resumes at the unfinished step"}\n' "$(exakit_install_command)"
            exit 3
        fi
        printf '\n  %s%s %sNo runtime recorded in the manifest yet — re-run the installer, it resumes at the unfinished step: %s%s\n' \
            "${UI_ERR:-}" "${UI_CROSS:-[x]}" "${UI_BOLD:-}" "$(exakit_install_command)" "${UI_RESET:-}" >&2
        exit 3
    fi
}

# _not_installed_answer <json:0|1> — the not-installed answer for a STATE QUERY.
#
# A bare `die` here fails an agent twice over: it exits 1 where the documented
# contract says 4, and it leaves stdout empty, so a caller piping --json into a
# parser gets "Expecting value: line 1 column 1" on precisely the path where
# structured signal matters most. `status --json` always answered with an
# object; the other state queries did not, and the three disagreed.
# _exakit_platform_json_fields — `"platform": …, "wsl_version": …` for the
# answers printed without the status Python (not installed, no interpreter).
# AGENTS.md tells agents to branch on `platform` to tell a remedy they can run
# from one they must hand to the user, and it was missing from exactly the
# answers an agent sees first. Same values as the installed-state answer.
_exakit_platform_json_fields() {
    _pj_os="$(detect_os 2>/dev/null || true)"
    _pj_wsl="$(detect_wsl_version 2>/dev/null || true)"
    case "$_pj_os" in
        ""|*[!a-z0-9_-]*) _pj_os_json="null" ;;
        *)                _pj_os_json="\"$_pj_os\"" ;;
    esac
    case "$_pj_wsl" in
        ""|*[!0-9]*) _pj_wsl_json="null" ;;
        *)           _pj_wsl_json="$_pj_wsl" ;;
    esac
    printf '"platform": %s, "wsl_version": %s' "$_pj_os_json" "$_pj_wsl_json"
}

_not_installed_answer() {
    if [ "${1:-0}" -eq 1 ]; then
        # `installed`, `status` and `remedy` appear in EVERY --json answer these
        # state queries can give (see the db-not-running answer in
        # cmd_mcp_doctor). They used to differ per state with no key in common,
        # so a parser that read .status off the healthy shape hit a KeyError on
        # exactly the two states worth branching on.
        printf '{"installed": false, "status": "not installed", "manifest": "%s", "reason": "no install record", "remedy": "%s", %s}\n' \
            "$EXAKIT_MANIFEST" "$(exakit_install_command)" "$(_exakit_platform_json_fields)"
    else
        printf 'Not installed (no manifest at %s). Run the installer first.\n' "$EXAKIT_MANIFEST" >&2
    fi
    exit 4
}

# cmd_status [--json] — what is installed and whether it is up.
#
# THE EXIT CODE IS PART OF THE ANSWER. An unattended agent branches on $?, not
# on prose, so this command distinguishes its states the way `git diff --quiet`
# or `systemctl is-active` do:
#     0  installed and the database is running
#     3  installed but the database is NOT running (start it: exakit start)
#     4  not installed at all
# `--json` prints one machine-readable object built from the same fields the
# prose shows (same exit codes; nothing else on stdout). Loaded datasets are
# included in both forms: the manifest records them, and reconstructing state
# after a context reset must not require knowing where that file lives.
# _cs_mcp_clients — "<label>|<state>" per AI client, from the manifest alone.
#
# configured_clients is what mcp-setup actually wrote; every other known client
# is reported as not installed. No probing and no config parsing: this is the
# state the kit recorded, and `exakit mcp-doctor` is the command that re-checks
# it against the machine.
_cs_mcp_clients() {
    manifest_get components.mcp_server.client_setup.configured_clients >/dev/null 2>&1 || return 0
    exakit_can_run_python_any 2>/dev/null || return 0
    run_python_any - "$EXAKIT_MANIFEST" <<'EXAKIT_CS_MCP'
import json, sys

LABELS = [
    ("claude_desktop", "Claude"),
    ("claude_code", "Claude Code (CLI)"),
    ("cursor", "Cursor"),
    ("codex", "Codex"),
    ("vscode_copilot", "GitHub Copilot"),
    ("gemini_cli", "Gemini CLI"),
    ("opencode", "OpenCode"),
    ("continue", "Continue"),
]
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        doc = json.load(handle)
except (OSError, ValueError):
    raise SystemExit(0)
setup = (
    doc.get("components", {}).get("mcp_server", {}).get("client_setup", {}) or {}
)
configured = set(setup.get("configured_clients") or [])
skipped = set(setup.get("skipped_clients") or [])
for key, label in LABELS:
    if key in configured:
        state = "configured"
    elif key in skipped:
        state = "skipped"
    else:
        state = "not installed"
    print("%s|%s" % (label, state))
EXAKIT_CS_MCP
}

cmd_status() {
    _cs_json=0
    for _cs_arg in "$@"; do
        case "$_cs_arg" in
            --json|-j) _cs_json=1 ;;
            *) reject "Unknown option '$_cs_arg' for status (supported: --json)." ;;
        esac
    done
    # One helper for all three state queries, so status/info/mcp-doctor cannot
    # drift apart again on the shape or the exit code of this answer.
    [ -f "$EXAKIT_MANIFEST" ] || _not_installed_answer "$_cs_json"
    _type="$(_runtime_type)"
    # Each phase names what it is waiting on. Only drawn on a terminal, and
    # never for --json: ui_spin_begin re-checks that at call time, and the
    # command substitutions below capture their own stdout regardless.
    if [ "$_cs_json" -eq 0 ]; then ui_spin_begin "Checking the database"; fi
    case "$_type" in
        personal) _cs_db="$(personal_status)" ;;
        # NO RUNTIME RECORDED is a state the kit knows exactly, not an unknown:
        # the installer has not reached its runtime step, so no database is
        # deployed. It used to answer "unknown", a word in no documented status
        # vocabulary, and "unknown" matched none of the arms below - so the
        # prose screen fell through to "Start it: exakit start", a command that
        # in this state can only answer "No runtime recorded in the manifest
        # yet". "not installed" is the same string the runtimes themselves use
        # for a missing deployment: it maps to the top-level status "no
        # database" and to the installer's own command as the remedy, in the
        # JSON and on the screen alike.
        *)        _cs_db="not installed" ;;
    esac
    if [ "$_cs_json" -eq 0 ]; then ui_spin_end; fi
    _cs_running=0
    case "$_cs_db" in running*) _cs_running=1 ;; esac
    # REALITY, NOT THE RECORDED INTENT. This read the manifest's
    # autostart.enabled, which is what the user last ASKED for - so a machine
    # whose boot entry had since gone reported "autostart: true" for a database
    # nothing would restart. On the container path that is routine: recreating
    # the container drops its restart policy, and a stop/start cycle was enough
    # to turn autostart off with the manifest still saying it was on. The
    # answer to "will this come back after a reboot" has to be a probe, and
    # _exakit_autostart_registered is the probe `exakit autostart` already
    # uses. Same rule as that command: on means EVERY service is registered,
    # because a partly-registered set will not bring the kit back.
    _cs_autostart=false
    _cs_as_total=0
    _cs_as_on=0
    for _cs_as_id in $(exakit_service_ids 2>/dev/null); do
        _cs_as_total=$(( _cs_as_total + 1 ))
        if _exakit_autostart_registered "$_cs_as_id" 2>/dev/null; then
            _cs_as_on=$(( _cs_as_on + 1 ))
        fi
    done
    [ "$_cs_as_total" -gt 0 ] && [ "$_cs_as_on" -eq "$_cs_as_total" ] && _cs_autostart=true
    if [ "$_cs_json" -eq 0 ]; then ui_spin_begin "Checking which datasets are loaded"; fi
    _cs_datasets="$(exakit_loaded_datasets 2>/dev/null | tr '\n' ' ' | sed 's/ $//')"
    if [ "$_cs_json" -eq 0 ]; then ui_spin_end; fi
    _cs_pyx="$(exakit_component_current pyexasol 2>/dev/null || true)"
    # An install in progress is its own state. The step name is in the manifest
    # (begin_step writes it) and the lock names the installer's pid; both have
    # to agree, so a crashed install never reads as "installing" forever.
    _cs_installing=0
    _cs_step="$(manifest_get install.current_step 2>/dev/null || true)"
    # The lock holder must be the SAME process that took the lock, not merely a
    # live process with that pid: a crashed installer's pid gets reused, and
    # status then said "installing" for as long as the newcomer lived.
    if [ -n "$_cs_step" ] && exakit_lock_holder_alive "$EXAKIT_HOME/.install.lock"; then
        _cs_installing=1
    fi
    # What the crossing remembered about an older kit's container database, if
    # anything: where it is, what was answered, whether its tables landed.
    _cs_legacy_c="$(manifest_get legacy.container 2>/dev/null || true)"
    _cs_legacy_e="$(manifest_get legacy.engine 2>/dev/null || true)"
    _cs_legacy_choice="$(manifest_get legacy.choice 2>/dev/null || true)"
    _cs_legacy_restored="$(manifest_get legacy.restored 2>/dev/null || true)"
    _cs_legacy_sample="$(manifest_get legacy.sample_left_out 2>/dev/null || true)"

    if [ "$_cs_json" -eq 1 ]; then
        # Composed in Python so every value is escaped properly; the service
        # map is passed pre-joined because the registry drives it.
        _cs_services=""
        _cs_urls=""
        for _st_id in $(exakit_service_ids 2>/dev/null); do
            [ "$_st_id" = "database" ] && continue
            _cs_services="${_cs_services}${_st_id}=$(exakit_service_status "$_st_id")
"
            # A service that knows its address says so through the `url` hook,
            # and the JSON carries it - an agent could not get dash-server's
            # URL from any machine-readable surface before this.
            _cs_url_fn="$(_exakit_addon_fn "$_st_id" url)"
            if command -v "$_cs_url_fn" >/dev/null 2>&1; then
                _cs_urls="${_cs_urls}${_st_id}=$("$_cs_url_fn" 2>/dev/null || true)
"
            fi
        done
        # The last recorded failure, if one is still pending. The human screen
        # already prints "pyexasol: not installed — repair: exakit update
        # pyexasol"; the JSON carried only `"pyexasol": null`, so the agent's
        # own channel was the one missing the actionable half.
        _cs_note=""
        _cs_note_at=""
        if [ -f "$EXAKIT_HOME/.last-failure" ]; then
            _cs_note="$(sed -n '1p' "$EXAKIT_HOME/.last-failure" 2>/dev/null || true)"
            # Line 2 is the timestamp. Reporting a reason without a date invites
            # an agent to act on a note whose cause was fixed long ago.
            _cs_note_at="$(sed -n '2p' "$EXAKIT_HOME/.last-failure" 2>/dev/null || true)"
        fi
        # No interpreter anywhere, and this is a read-only query, so nothing may
        # be installed to get one (exakit_ensure_uv refuses). Degrade honestly:
        # one object, the three contract keys, and a remedy that names the
        # command which puts a Python runtime back — never a corrupt answer and
        # never a silent side effect.
        if ! exakit_can_run_python_any; then
            printf '{"installed": true, "status": "unknown", "remedy": "exakit update", "remedy_hint": "no Python runtime is available on this machine, so the kit cannot read its own install record; exakit update restores it", "installing": false, "install_step": null, "runtime": {"type": null, "status": "unknown"}, "running": false, "remedies": {}, "remedy_hints": {}, "manifest": "%s", %s}\n' \
                "$EXAKIT_MANIFEST" "$(_exakit_platform_json_fields)"
            exit 3
        fi
        run_python_any - "$(manifest_get kit_level 2>/dev/null)" "${_type:-}" "$_cs_db"             "${_cs_autostart:-false}" "$_cs_datasets" "${_cs_pyx:-}" "$EXAKIT_MANIFEST"             "$(manifest_get steps_completed 2>/dev/null)" "$_cs_services" "$_cs_note" "$_cs_note_at" \
            "$_cs_installing" "$_cs_step" "$_cs_urls" "$(exakit_install_command)" \
            "$_cs_legacy_c" "$_cs_legacy_e" "$_cs_legacy_choice" "$_cs_legacy_restored" "$_cs_legacy_sample" \
            "$(detect_os 2>/dev/null || true)" "$(detect_wsl_version 2>/dev/null || true)" <<'EXAKIT_SJ_PY'
import json, sys
kit, rtype, db, autostart, datasets, pyx, manifest, steps, services, note, note_at, installing, step, urls, install_cmd = sys.argv[1:16]
legacy_c, legacy_e, legacy_choice, legacy_restored, legacy_sample = (sys.argv[16:21] + [""] * 5)[:5]
host_platform, wsl_version = (sys.argv[21:23] + [""] * 2)[:2]
installing = installing == "1"
try:
    steps_list = json.loads(steps) if steps else []
except ValueError:
    steps_list = []
smap = {}
for line in services.splitlines():
    if "=" in line:
        key, value = line.split("=", 1)
        smap[key] = value
umap = {}
