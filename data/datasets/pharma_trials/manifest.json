{
  "id": "pharma_trials",
  "source": {
    "name": "ClinicalTrials.gov API v2 (U.S. National Library of Medicine)",
    "url": "https://clinicaltrials.gov/api/v2/studies",
    "query": {
      "filter.advanced": "AREA[StudyType]INTERVENTIONAL AND AREA[Phase](PHASE2 OR PHASE3) AND AREA[StartDate]RANGE[2016-01-01,2018-12-31] AND AREA[LeadSponsorClass]INDUSTRY",
      "filter.overallStatus": "COMPLETED,TERMINATED",
      "fields": "NCTId,BriefTitle,Phase,OverallStatus,StartDate,PrimaryCompletionDate,EnrollmentCount,LeadSponsorName,DesignAllocation,DesignPrimaryPurpose,DesignMasking,Condition,InterventionType,InterventionName,BriefSummary,WhyStopped,HasResults"
    },
    "builder": "tools/datasets/pharma_trials.py"
  },
  "terms": {
    "url": "https://clinicaltrials.gov/about-site/terms-conditions",
    "summary": "ClinicalTrials.gov data are provided by the U.S. National Library of Medicine; the site asks users to cite it as the source and not to imply endorsement.",
    "confirmed": false
  },
