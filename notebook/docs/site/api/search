add-ons-29","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dash-server","content":"**Install:** `exakit marketplace dash-server`"},"2965":{"id":"/kit/tools/add-ons-30","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dash-server","content":"**Repository:** exasol-labs/dash-server"},"2966":{"id":"/kit/tools/add-ons-31","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dash-server","content":"**Documentation:** repository README."},"2967":{"id":"/kit/tools/add-ons-32","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dbt-exasol","content":"**What it is:** Data Build Tool adapter for Exasol."},"2968":{"id":"/kit/tools/add-ons-33","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dbt-exasol","content":"**Install:** `exakit marketplace dbt-exasol`"},"2969":{"id":"/kit/tools/add-ons-34","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dbt-exasol","content":"**Repository:** exasol/dbt-exasol"},"2970":{"id":"/kit/tools/add-ons-35","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#dbt-exasol","content":"**Documentation:** dbt's Exasol setup page, and the repository README."},"2971":{"id":"/kit/tools/add-ons-36","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-scheduler","content":"**What it is:** Lightweight table-driven SQL job scheduling for Exasol."},"2972":{"id":"/kit/tools/add-ons-37","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-scheduler","content":"**Install:** `exakit marketplace exasol-scheduler`"},"2973":{"id":"/kit/tools/add-ons-38","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-scheduler","content":"**Repository:** exasol-labs/exasol-scheduler"},"2974":{"id":"/kit/tools/add-ons-39","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-scheduler","content":"**Documentation:** repository README."},"2975":{"id":"/kit/tools/add-ons-40","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-vscode","content":"**What it is:** A Visual Studio Code extension for working with Exasol databases. Provides comprehensive database management, intelligent SQL editing, and powerful query execution capabilities."},"2976":{"id":"/kit/tools/add-ons-41","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-vscode","content":"**Install:** `exakit marketplace exasol-vscode`. If you installed the extension yourself, the kit leaves it as yours and does not replace it."},"2977":{"id":"/kit/tools/add-ons-42","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-vscode","content":"**Repository:** exasol-labs/exasol-vscode"},"2978":{"id":"/kit/tools/add-ons-43","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#exasol-vscode","content":"**Documentation:** repository README."},"2979":{"id":"/kit/tools/add-ons-44","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#json-tables","content":"**What it is:** Exasol JSON Tables: ingest, query, and reshape JSON-shaped data in Exasol."},"2980":{"id":"/kit/tools/add-ons-45","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#json-tables","content":"**Install:** `exakit marketplace json-tables`"},"2981":{"id":"/kit/tools/add-ons-46","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#json-tables","content":"**Repository:** exasol-labs/exasol-json-tables"},"2982":{"id":"/kit/tools/add-ons-47","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#json-tables","content":"**Documentation:** repository README, and Exasol's JSON functions."},"2983":{"id":"/kit/tools/add-ons-48","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#semantic-views","content":"**What it is:** A database-native semantic layer for Exasol."},"2984":{"id":"/kit/tools/add-ons-49","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#semantic-views","content":"**Install:** `exakit marketplace semantic-views`. The first approval of a column map installs it into the database if it is missing, as Semantic Views describes."},"2985":{"id":"/kit/tools/add-ons-50","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#semantic-views","content":"**Repository:** exasol-labs/exasol-semantic-views"},"2986":{"id":"/kit/tools/add-ons-51","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#semantic-views","content":"**Documentation:** repository README."},"2987":{"id":"/kit/tools/add-ons-52","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#notebook","content":"**What it is:** Connection configuration management and additional tools for Jupyter notebooks."},"2988":{"id":"/kit/tools/add-ons-53","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#notebook","content":"**Install:** `exakit marketplace notebook`. It offers two front ends, JupyterLab and Marimo. See Notebooks."},"2989":{"id":"/kit/tools/add-ons-54","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#notebook","content":"**Repository:** exasol/notebook-connector"},"2990":{"id":"/kit/tools/add-ons-55","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#notebook","content":"**Documentation:** repository README. The driver the notebooks use is documented in Exasol's PyExasol page."},"2991":{"id":"/kit/tools/add-ons-56","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#udf-devkit","content":"**What it is:** Run Python and Rust code inside the database: UDF containers, model files in BucketFS, a local MLflow. The kit writes this line in place of its repository's About text, because the repository is the upstream it is built on."},"2992":{"id":"/kit/tools/add-ons-57","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#udf-devkit","content":"**Install:** Not available in this release. The catalog marks the add-on `visible: false`, and `exakit marketplace udf-devkit` refuses it with \"is disabled in marketplace/catalog.json\"."},"2993":{"id":"/kit/tools/add-ons-58","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#udf-devkit","content":"**Repository:** exasol/script-languages-release. This is the upstream repository the kit builds its containers from."},"2994":{"id":"/kit/tools/add-ons-59","page_id":"/kit/tools/add-ons","tags":[],"type":"text","url":"/kit/tools/add-ons#udf-devkit","content":"**Documentation:** Exasol's user-defined functions, Python in UDFs, and BucketFS."},"2995":{"id":"/kit/tools/ai-clients-and-skills","page_id":"/kit/tools/ai-clients-and-skills","type":"page","content":"AI clients and skills","breadcrumbs":["Documentation","All personas","Tools"],"tags":[],"url":"/kit/tools/ai-clients-and-skills"},"2996":{"id":"/kit/tools/ai-clients-and-skills-0","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills","content":"Connect your AI clients to the database, check the connection, and see the skills the kit gives them."},"2997":{"id":"/kit/tools/ai-clients-and-skills-1","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#connect","content":"Connect"},"2998":{"id":"/kit/tools/ai-clients-and-skills-2","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#check-and-repair","content":"Check and repair"},"2999":{"id":"/kit/tools/ai-clients-and-skills-3","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#skills","content":"Skills"},"3000":{"id":"/kit/tools/ai-clients-and-skills-4","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#what-a-client-can-and-cannot-do","content":"What a client can and cannot do"},"3001":{"id":"/kit/tools/ai-clients-and-skills-5","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#from-a-notebook","content":"From a notebook"},"3002":{"id":"/kit/tools/ai-clients-and-skills-6","page_id":"/kit/tools/ai-clients-and-skills","type":"heading","tags":[],"url":"/kit/tools/ai-clients-and-skills#further-reading","content":"Further reading"},"3003":{"id":"/kit/tools/ai-clients-and-skills-7","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills","content":"The kit connects AI clients to the database through its AI bridge. A client connected this way reads data as the kit's read-only user."},"3004":{"id":"/kit/tools/ai-clients-and-skills-8","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#connect","content":"It configures the `exasol` MCP server in every supported AI client. Existing configs are backed up first. To name the clients yourself, set `EXAKIT_MCP_CLIENTS` before the command:"},"3005":{"id":"/kit/tools/ai-clients-and-skills-9","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#connect","content":"Restart each client afterwards and look for a server named `exasol`."},"3006":{"id":"/kit/tools/ai-clients-and-skills-10","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#check-and-repair","content":"Both take `--json` for a script."},"3007":{"id":"/kit/tools/ai-clients-and-skills-11","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#skills","content":"A **skill** is a set of instructions that teaches an AI client how to use the kit: which command loads data, how to read a column map, where dashboards go."},"3008":{"id":"/kit/tools/ai-clients-and-skills-12","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#skills","content":"Skills update with the kit, so a new skill reaches every installed kit through `exakit update`."},"3009":{"id":"/kit/tools/ai-clients-and-skills-13","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#what-a-client-can-and-cannot-do","content":"It reads through the read-only user. It cannot change your data."},"3010":{"id":"/kit/tools/ai-clients-and-skills-14","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#what-a-client-can-and-cannot-do","content":"It reads the approved column maps, so it works from the roles you approved."},"3011":{"id":"/kit/tools/ai-clients-and-skills-15","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#what-a-client-can-and-cannot-do","content":"The notebooks send a model names, types, notes and a column's most frequent values for most AI steps. One step sends row text: the themes step in Explore (`nb.themes`) sends the text column of sampled rows, up to 600 characters each, to sort them into themes. Every AI step is off until you set a model up. See What goes to a model and AI and tracing."},"3012":{"id":"/kit/tools/ai-clients-and-skills-16","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#further-reading","content":"Exasol MCP server documentation, and its repository. The kit runs this server beside the database and copies its skills."},"3013":{"id":"/kit/tools/ai-clients-and-skills-17","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#further-reading","content":"Privileges and GRANT, the rules behind the read-only user."},"3014":{"id":"/kit/tools/ai-clients-and-skills-18","page_id":"/kit/tools/ai-clients-and-skills","tags":[],"type":"text","url":"/kit/tools/ai-clients-and-skills#further-reading","content":"AI clients and the read-only user, the security view of the same connection, with its limits."},"3015":{"id":"/kit/tools/notebooks","page_id":"/kit/tools/notebooks","type":"page","content":"Notebooks","breadcrumbs":["Documentation","All personas","Tools"],"tags":[],"url":"/kit/tools/notebooks"},"3016":{"id":"/kit/tools/notebooks-0","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks","content":"Open JupyterLab or Marimo on the kit's own Python, already connected to the database."},"3017":{"id":"/kit/tools/notebooks-1","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#open","content":"Open"},"3018":{"id":"/kit/tools/notebooks-2","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#check-set-up-stop","content":"Check, set up, stop"},"3019":{"id":"/kit/tools/notebooks-3","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#where-the-notebooks-are","content":"Where the notebooks are"},"3020":{"id":"/kit/tools/notebooks-4","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#what-an-update-does-to-them","content":"What an update does to them"},"3021":{"id":"/kit/tools/notebooks-5","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#a-notebook-of-your-own","content":"A notebook of your own"},"3022":{"id":"/kit/tools/notebooks-6","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#the-documentation-from-a-notebook","content":"The documentation, from a notebook"},"3023":{"id":"/kit/tools/notebooks-7","page_id":"/kit/tools/notebooks","type":"heading","tags":[],"url":"/kit/tools/notebooks#further-reading","content":"Further reading"},"3024":{"id":"/kit/tools/notebooks-8","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks","content":"The notebook add-on brings JupyterLab and Marimo, the kit's notebooks and the helpers they use. Install it with a persona that has notebooks, or with `exakit marketplace notebook`."},"3025":{"id":"/kit/tools/notebooks-9","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#open","content":"It starts on this computer only and opens in your browser, already signed in. The kernel is **Exasol (Starter Kit)**."},"3026":{"id":"/kit/tools/notebooks-10","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#open","content":"Every run first writes the kit's current connection into the notebooks' encrypted store, so a database restart or a port change needs no edit. It also copies any kit notebook you do not have yet. Yours are never overwritten."},"3027":{"id":"/kit/tools/notebooks-11","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#where-the-notebooks-are","content":"Tool"},"3028":{"id":"/kit/tools/notebooks-12","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#where-the-notebooks-are","content":"Folder"},"3029":{"id":"/kit/tools/notebooks-13","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#where-the-notebooks-are","content":"JupyterLab"},"3030":{"id":"/kit/tools/notebooks-14","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#where-the-notebooks-are","content":"`~/.exasol-starter-kit/notebooks/starter-kit-notebooks/<persona>/`"},"3031":{"id":"/kit/tools/notebooks-15","page_id":"/kit/tools/notebooks","tags":[],"type":"text","url":"/kit/tools/notebooks#where-the-notebooks-are","content":"Marimo"},"3032":{"id