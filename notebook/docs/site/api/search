kflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"`model`"},"3063":{"id":"/kit/tools/workflows-21","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"A model was trained and scored"},"3064":{"id":"/kit/tools/workflows-22","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"`trace`"},"3065":{"id":"/kit/tools/workflows-23","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"A model call was traced"},"3066":{"id":"/kit/tools/workflows-24","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"`dashboard.revision`"},"3067":{"id":"/kit/tools/workflows-25","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"A dashboard was previewed or published"},"3068":{"id":"/kit/tools/workflows-26","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"`handoff`"},"3069":{"id":"/kit/tools/workflows-27","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"A hand-off was written"},"3070":{"id":"/kit/tools/workflows-28","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"`guide_action`"},"3071":{"id":"/kit/tools/workflows-29","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"A button or form on a notebook card ran, with the code it ran and whether it worked"},"3072":{"id":"/kit/tools/workflows-30","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#show-one","content":"Add `--json` to either command for a script."},"3073":{"id":"/kit/tools/workflows-31","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#where-the-logs-are","content":"`~/.exasol-starter-kit/workflows/<id>.jsonl`, one JSON object per line, readable by you only."},"3074":{"id":"/kit/tools/workflows-32","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#no-secrets","content":"The helpers refuse a password, a token, a secret or an API key, and a connection string with a password in it. The log never holds a credential."},"3075":{"id":"/kit/tools/workflows-33","page_id":"/kit/tools/workflows","tags":[],"type":"text","url":"/kit/tools/workflows#no-secrets","content":"The workflow log is written by the notebook helpers, so this command needs the notebook add-on: `exakit marketplace notebook`."},"3076":{"id":"/kit/data/column-maps","page_id":"/kit/data/column-maps","type":"page","content":"Column maps","breadcrumbs":["Documentation","All personas","Data"],"tags":[],"url":"/kit/data/column-maps"},"3077":{"id":"/kit/data/column-maps-0","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps","content":"Say what each column of a table means with exakit describe - draft, correct, approve, and see every version."},"3078":{"id":"/kit/data/column-maps-1","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#draft","content":"Draft"},"3079":{"id":"/kit/data/column-maps-2","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#approve","content":"Approve"},"3080":{"id":"/kit/data/column-maps-3","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#what-you-get-at-the-end","content":"What you get at the end"},"3081":{"id":"/kit/data/column-maps-4","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#see-and-compare","content":"See and compare"},"3082":{"id":"/kit/data/column-maps-5","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#a-whole-schema","content":"A whole schema"},"3083":{"id":"/kit/data/column-maps-6","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#where-they-are-kept","content":"Where they are kept"},"3084":{"id":"/kit/data/column-maps-7","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#when-the-table-changes","content":"When the table changes"},"3085":{"id":"/kit/data/column-maps-8","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#with-an-ai-model","content":"With an AI model"},"3086":{"id":"/kit/data/column-maps-9","page_id":"/kit/data/column-maps","type":"heading","tags":[],"url":"/kit/data/column-maps#from-a-notebook","content":"From a notebook"},"3087":{"id":"/kit/data/column-maps-10","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps","content":"A **column map** (the descriptor) gives every column of a table a role. Notebooks and AI clients read it, so they all work from the same meaning. For the idea behind it, see Column map and approval."},"3088":{"id":"/kit/data/column-maps-11","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#draft","content":"The table is profiled with SELECTs only. Nothing is written to the database. Every column gets one of eight roles, with its confidence and the evidence that chose it:"},"3089":{"id":"/kit/data/column-maps-12","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#draft","content":"`key`, `time`, `measure`, `category`, `flag`, `text`, `identifier`, `other`."},"3090":{"id":"/kit/data/column-maps-13","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#draft","content":"The draft is deterministic: the same table gives the same draft."},"3091":{"id":"/kit/data/column-maps-14","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#draft","content":"A column whose values look like e-mail addresses, phone numbers, IBANs or postcodes is marked **sensitive**."},"3092":{"id":"/kit/data/column-maps-15","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#draft","content":"The **target** is never drafted. Only a person sets it."},"3093":{"id":"/kit/data/column-maps-16","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"`--role <slot>=<COLUMN>` corrects a slot: `key`, `time`, `text`, `target`, `category`, `entity`. `<slot>=-` leaves it empty."},"3094":{"id":"/kit/data/column-maps-17","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"Approval:"},"3095":{"id":"/kit/data/column-maps-18","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"checks that every column has a role, that none sits in two slots, and that the table has not changed since it was profiled"},"3096":{"id":"/kit/data/column-maps-19","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"writes a new version, never rewriting an old one"},"3097":{"id":"/kit/data/column-maps-20","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"publishes the roles in Exasol Semantic Views: the schema's semantic model is rebuilt with this table as an entity, readable by the read-only AI user. Semantic Views is installed first when the database does not have it yet."},"3098":{"id":"/kit/data/column-maps-21","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#approve","content":"Your own table is never commented. If publishing fails, the approval still stands and the message says why."},"3099":{"id":"/kit/data/column-maps-22","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#what-you-get-at-the-end","content":"A new version of the column map, kept under `~/.exasol-starter-kit/descriptors/`, and the schema's semantic model (its views in `SEM_<SCHEMA>`) rebuilt from it. The notebooks and AI clients read the approved version from then on."},"3100":{"id":"/kit/data/column-maps-23","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#see-and-compare","content":"Add `--json` to any of them for a script."},"3101":{"id":"/kit/data/column-maps-24","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#a-whole-schema","content":"This lists every table with its rows and key, and every many-to-one link between tables with its evidence. A link is a foreign key the database declares, or a column whose values are in another table's key (at most 0.1% of them may be missing). A name alone never makes a link."},"3102":{"id":"/kit/data/column-maps-25","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#a-whole-schema","content":"`--link TABLE.COLUMN=TABLE.KEY` adds a link and `--unlink TABLE.COLUMN` removes one. The approved links become relationships of the schema's semantic model. To join tables of different schemas, build a multi-source model."},"3103":{"id":"/kit/data/column-maps-26","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#where-they-are-kept","content":"`~/.exasol-starter-kit/descriptors/<SCHEMA>.<TABLE>/`: the draft, every approved version and the current one."},"3104":{"id":"/kit/data/column-maps-27","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#when-the-table-changes","content":"Columns whose name and type did not change keep their approved roles. The rest are flagged, and you approve again."},"3105":{"id":"/kit/data/column-maps-28","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#with-an-ai-model","content":"When a model is set up, one call adds a one-line note per column. It is sent each column's name, type, role, evidence and top values, never a row and never a sensitive column. A note never decides a role."},"3106":{"id":"/kit/data/column-maps-29","page_id":"/kit/data/column-maps","tags":[],"type":"text","url":"/kit/data/column-maps#from-a-notebook","content":"See Review and approve the column map."},"3107":{"id":"/kit/data/datasets","page_id":"/kit/data/datasets","type":"page","content":"Datasets","breadcrumbs":["Documentation","All personas","Data"],"tags":[],"url":"/kit/data/datasets"},"3108":{"id":"/kit/data/datasets-0","page_id":"/kit/data/datasets","tags":[],"type":"text","url":"/kit/data/datasets","content":"The sample datasets the kit carries, where each comes from, and which persona loads it."},"3109":{"id":"/kit/data/datasets-1","page_id":"/kit/data/datasets","type":"heading","tags":[],"url":"/kit/data/datasets#downloaded-datasets","content":"Downloaded datasets"},"3110":{"id":"/kit/data/datasets-2","page_id":"/kit/data/datasets","type":"heading","tags":[],"url":"/kit/data/datasets#a-dataset-with-a-column-map","content":"A dataset with a column map"},"3111":{"id":"/kit/data/datasets-3","page_id":"/kit/data/datasets","type":"heading","tags":[],"url":"/kit/data/datasets#load-one-again","content":"Load one again"},"3112":{"id":"/kit/data/datasets-4","page_id":"/kit/data/datasets","type":"heading","tags":[],"url":"/kit/data/datasets#add-a-dataset-to-the-kit","content":"Add a dataset to the kit"},"3113":{"id":"/kit/data/datasets-5","page_id":"/kit/data/datasets","tags":[],"type":"text","url":"/kit/data/datasets","content":"The kit carries sample datasets to practise on. `exakit data-load` lists them and loads the ones you pick."},"3114":{"id":"/kit/data/datasets-6","page_id":"/kit/data/datasets","tags":[],"type":"text","url":"/kit/data/datasets","content":"Dataset"},"3115":{"id":"/kit/data/datasets-7","page_id":"/kit/data/datasets","tags":[],"type":"text","url":"/kit/data/datasets","content":"Loaded by"},"3116":{"id":"/kit/data/datasets-8","page_id":"/ki