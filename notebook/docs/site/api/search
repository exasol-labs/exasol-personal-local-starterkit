et-41","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`current_table_digest(conn) -> str`"},"646":{"id":"/data-scientist/reference/dataset-42","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The table's digest as it is now, computed the way approve computed `table_digest`; a value that differs from `table_digest` means the data changed since the descriptor was approved (a virtual table's digest covers its first sample rows and the row count)."},"647":{"id":"/data-scientist/reference/dataset-43","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`drafted_by`"},"648":{"id":"/data-scientist/reference/dataset-44","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`profile` (exakit describe), `shipped` (the kit) or `user` (roles given by hand)."},"649":{"id":"/data-scientist/reference/dataset-45","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`evidence`"},"650":{"id":"/data-scientist/reference/dataset-46","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"Per role, the numbers that chose its column (what the profiler recorded; empty for roles given by hand)."},"651":{"id":"/data-scientist/reference/dataset-47","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`notes`"},"652":{"id":"/data-scientist/reference/dataset-48","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"Per column, a model-written line about it (never decisive; empty without a model)."},"653":{"id":"/data-scientist/reference/dataset-49","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`missing`"},"654":{"id":"/data-scientist/reference/dataset-50","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The roles no column fits, each `{role, reason}`; the notebooks skip what depends on them with the reason."},"655":{"id":"/data-scientist/reference/dataset-51","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`require_approved(purpose: str) -> Dataset`"},"656":{"id":"/data-scientist/reference/dataset-52","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"This dataset when its descriptor is approved; a draft raises DescriptorNotApproved saying how to approve it."},"657":{"id":"/data-scientist/reference/dataset-53","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`col(role: str) -> str`"},"658":{"id":"/data-scientist/reference/dataset-54","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The column of a single-column role (entity, category, date, label)."},"659":{"id":"/data-scientist/reference/dataset-55","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`text_cols() -> list[str]`"},"660":{"id":"/data-scientist/reference/dataset-56","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The text columns, in the descriptor's order; none when no column plays the text role."},"661":{"id":"/data-scientist/ref