ference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`notes`"},"705":{"id":"/data-scientist/reference/dataset-48","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"Per column, a model-written line about it (never decisive; empty without a model)."},"706":{"id":"/data-scientist/reference/dataset-49","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`missing`"},"707":{"id":"/data-scientist/reference/dataset-50","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The roles no column fits, each `{role, reason}`; the notebooks skip what depends on them with the reason."},"708":{"id":"/data-scientist/reference/dataset-51","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`require_approved(purpose: str) -> Dataset`"},"709":{"id":"/data-scientist/reference/dataset-52","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"This dataset when its descriptor is approved; a draft raises DescriptorNotApproved saying how to approve it."},"710":{"id":"/data-scientist/reference/dataset-53","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`col(role: str) -> str`"},"711":{"id":"/data-scientist/reference/dataset-54","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The column of a single-column role (entity, category, date, label)."},"712":{"id":"/data-scientist/reference/dataset-55","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`text_cols() -> list[str]`"},"713":{"id":"/data-scientist/reference/dataset-56","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"The text columns, in the descriptor's order; none when no column plays the text role."},"714":{"id":"/data-scientist/reference/dataset-57","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`text_sql() -> str`"},"715":{"id":"/data-scientist/reference/dataset-58","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"One SQL expression joining the text columns with a space, NULLs as empty; a dataset without text raises ValueError with the descriptor's reason."},"716":{"id":"/data-scientist/reference/dataset-59","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`roles() -> list[tuple[str, str]]`"},"717":{"id":"/data-scientist/reference/dataset-60","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"(role, SCHEMA.TABLE.COLUMN) for every role, for a table the notebook prints."},"718":{"id":"/data-scientist/reference/dataset-61","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`has(role: str) -> bool`"},"719":{"id":"/data-scientist/reference/dataset-62","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"Whether a column plays `role` (False for one listed under `missing`)."},"720":{"id":"/data-scientist/reference/dataset-63","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`group_by() -> tuple[str, str]`"},"721":{"id":"/data-scientist/reference/dataset-64","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"(role, column) the overviews count rows by: the category, else the entity, else the target - a table with only a key, a text and a 0/1 target has no other group, and counting by that target is its overview."},"722":{"id":"/data-scientist/reference/dataset-65","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"`tags() -> dict[str, str]`"},"723":{"id":"/data-scientist/reference/dataset-66","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#Dataset","content":"What a trace or an MLflow run records about the data: the dataset and the descriptor's digest (and the source's alias for a live source)."},"724":{"id":"/data-scientist/reference/dataset-67","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#dataset","content":"The dataset `name`, checked against the database: a kit dataset id, a descriptor file or its folder, or a data\nfile of your own (CSV, Parquet or JSON) with its descriptor beside it, which is loaded first (load_own_file)."},"725":{"id":"/data-scientist/reference/dataset-68","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#dataset","content":"**Used in:** `data-scientist/02_ask_your_data`, `data-scientist/03_share`, `ml-engineer/01_train`, `ml-engineer/02_rust_score`, `ml-engineer/03_score_external_model`"},"726":{"id":"/data-scientist/reference/dataset-69","page_id":"/data-scientist/reference/dataset","tags":[],"type":"text","url":"/data-scientist/reference/dataset#DescriptorNotApproved","content":"A step that needs an approved descriptor was given a draft; the message says how to approve it."},"727":{"id":"/data-scientist/reference/describe","page_id":"/data-scientist/reference/describe","type":"page","content":"Describe a table","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference/describe"},"728":{"id":"/data-scientist/reference/describe-0","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe","content":"Describe a table from a notebook (DS-2, DS-5): the role-per-column descriptor of setup/lib/descriptor."},"729":{"id":"/data-scientist/reference/describe-1","page_id":"/data-scientist/reference/describe","type":"heading","tags":[],"url":"/data-scientist/reference/describe#describe","content":"nb.describe"},"730":{"id":"/data-scientist/reference/describe-2","page_id":"/data-scientist/reference/describe","type":"heading","tags":[],"url":"/data-scientist/reference/describe#Draft","content":"nb.Draft"},"731":{"id":"/data-scientist/reference/describe-3","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe","content":"describe() on a table whose approved descriptor still matches it returns that one (force=True profiles again);\notherwise the table is profiled once, in SQL, and every column gets one of eight roles with the evidence that chose\nit; the slots name the columns the notebooks use. show() lists each column with the schema and table it came from,\nits type, role, confidence, evidence and note, low confidence first, the slots above (rows() gives the same as dicts;\na notebook renders it as a table). approve() checks every column has a role and none sits in two slots, checks\nthe table has not changed since it was profiled, writes the next version into the kit's store and publishes the\nroles as column comments on a view in EXAKIT_SEMANTIC (a publish that fails leaves the approval standing, and says\nwhy). The active workflow's log gets one line."},"732":{"id":"/data-scientist/reference/describe-4","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe","content":"The work is the kit's own service, setup/lib/describe_service.py in the kit copy (the one `exakit describe` runs),\nloaded from its file and run in this process over the kit's connection; without the kit copy, `exakit describe --json` runs as a child process instead."},"733":{"id":"/data-scientist/reference/describe-5","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe","content":"The role review (role_picker) speaks the five roles of earlier descriptors - entity, category, date, label, text - so\n`roles`, `evidence`, `missing` and `set(role, column)` read and write the matching slots: date is the time\nslot and label the target."},"734":{"id":"/data-scientist/reference/describe-6","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#describe","content":"Describe `SCHEMA.TABLE` (or a dataset id's table): the approved descriptor when the table still matches it,\nelse a fresh draft. Uses the connection given, else opens the kit's. Only SELECTs run."},"735":{"id":"/data-scientist/reference/describe-7","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"A descriptor proposed for a table (status draft), or the approved one describe() returned."},"736":{"id":"/data-scientist/reference/describe-8","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Member"},"737":{"id":"/data-scientist/reference/describe-9","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"What it is"},"738":{"id":"/data-scientist/reference/describe-10","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`id`"},"739":{"id":"/data-scientist/reference/describe-11","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`table`"},"740":{"id":"/data-scientist/reference/describe-12","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`version`"},"741":{"id":"/data-scientist/reference/describe-13","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`status`"},"742":{"id":"/data-scientist/reference/describe-14","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`slots`"},"743":{"id":"/data-scientist/reference/describe-15","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`column_roles`"},"744":{"id":"/data-scientist/reference/describe-16","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`roles`"},"745":{"id":"/data-scientist/reference/describe-17","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"The five roles of earlier descriptors, read from the slots: \\{role: column}, \\{text: \\[column]}."},"746":{"id":"/data-scientist/reference/describe-18","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`evidence`"},"747":{"id":"/data-scientist/reference/describe-19","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Per role, the column with its role, confidence and the evidence that chose it, plus the profile's numbers."},"748":{"id":"/data-scientist/reference/describe-20","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`missing`"},"749":{"id":"/data-scientist/reference/describe-21","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"The roles no column plays, each with the reason the empty slot gives."},"750":{"id":"/data-scientist/reference/describe-22","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`notes`"},"751":{"id":"/data-scientist/reference/describe-23","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`columns() -> list[str]`"},"752":{"id":"/data-scientist/reference/describe-24","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"The table's columns, in table order."},"753":{"id":"/data-scientist/reference/describe-25","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`set(role: str \\| None=None, column: str \\| list[str] \\| None=None, **columns: str) -> Draft`"},"754":{"id":"/data-scientist/reference/describe-26","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`set(COLUMN=\"role\", ...)` gives columns a role (one of the eight); `set(\"label\", \"COLUMN\")`, the form of earlier descriptors, puts a column in that role's slot."},"755":{"id":"/data-scientist/reference/describe-27","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`slot(**slots: str \\| None) -> Draft`"},"756":{"id":"/data-scientist/reference/describe-28","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Put a column in a slot (key, time, text, target, category, entity), or None to leave it empty on purpose."},"757":{"id":"/data-scientist/reference/describe-29","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`assign(role: str, column: str \\| list[str] \\| None, reason: str \\| None=None) -> Draft`"},"758":{"id":"/data-scientist/reference/describe-30","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"The role review's correction: `role` (one of the five) to `column`, or empty with `reason`."},"759":{"id":"/data-scientist/reference/describe-31","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`copy() -> Draft`"},"760":{"id":"/data-scientist/reference/describe-32","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`to_dict() -> dict[str, Any]`"},"761":{"id":"/data-scientist/reference/describe-33","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"The descriptor document (a copy)."},"762":{"id":"/data-scientist/reference/describe-34","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`to_yaml() -> str`"},"763":{"id":"/data-scientist/reference/describe-35","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`save(path: str \\| Path) -> Path`"},"764":{"id":"/data-scientist/reference/describe-36","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Write the descriptor as YAML; exakit_nb.dataset(conn, path) reads it back."},"765":{"id":"/data-scientist/reference/describe-37","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`approve(owner: str \\| None=None, comments: bool=True, *, conn=None, sample: int \\| None=None)`"},"766":{"id":"/data-scientist/reference/describe-38","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Approve: every column has a role and none sits in two slots, the table has not changed since it was profiled, the next version is written into the kit's store with current.yaml, and the roles are published on a view in EXAKIT_SEMANTIC (`comments=False` skips it)."},"767":{"id":"/data-scientist/reference/describe-39","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`rows() -> list[dict[str, str]]`"},"768":{"id":"/data-scientist/reference/describe-40","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"One dict per column, low confidence first: the schema and table it came from, its name, type, role, confidence, evidence and note."},"769":{"id":"/data-scientist/reference/describe-41","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"`show() -> None`"},"770":{"id":"/data-scientist/reference/describe-42","page_id":"/data-scientist/reference/describe","tags":[],"type":"text","url":"/data-scientist/reference/describe#Draft","content":"Print each column with its schema and table, type, role, confidence, evidence and note, low confidence first, the slots above."},"771":{"id":"/data-scientist/reference/descriptor-store","page_id":"/data-scientist/reference/descriptor-store","type":"page","content":"Approved column maps","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference/descriptor-store"},"772":{"id":"/data-scientist/reference/descriptor-store-0","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store","content":"Where a user's approved descriptors live."},"773":{"id":"/data-scientist/reference/descriptor-store-1","page_id":"/data-scientist/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/reference/descriptor-store#approved_datasets","content":"nb.approved_datasets"},"774":{"id":"/data-scientist/reference/descriptor-store-2","page_id":"/data-scientist/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/reference/descriptor-store#column_map_versions","content":"nb.column_map_versions"},"775":{"id":"/data-scientist/reference/descriptor-store-3","page_id":"/data-scientist/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/reference/descriptor-store#current_version","content":"nb.current_version"},"776":{"id":"/data-scientist/reference/descriptor-store-4","page_id":"/data-scientist/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/reference/descriptor-store#descriptor_store_dir","content":"nb.descriptor_store_dir"},"777":{"id":"/data-scientist/reference/descriptor-store-5","page_id":"/data-scientist/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/reference/descriptor-store#list_versions","content":"nb.list_versions"},"778":{"id":"/data-scientist/reference/descriptor-store-6","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store","content":"Where a user's approved descriptors live. Today: `~/.exasol-starter-kit/descriptors/<SCHEMA>.<TABLE>/current.yaml`\n(setup/lib/descriptor/store.py writes it; table_descriptor() finds it by its dataset id). Before that, and still read:\n`~/.exasol-starter-kit/descriptors/<id>/` (the kit's home, EXAKIT_HOME\nwhen set) holds one `v<n>.yaml` per version and `current`, a text file with the number of the approved version.\nRead-only here: `exakit describe <id> --approve` and `Draft.approve()` write versions; `Dataset` reads the\ncurrent one before it falls back to a shipped descriptor."},"779":{"id":"/data-scientist/reference/descriptor-store-7","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#approved_datasets","content":"Every dataset with an approved column map, newest approval first: \\{id, table, version, approved_at}."},"780":{"id":"/data-scientist/reference/descriptor-store-8","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#approved_datasets","content":"**Used in:** `data-scientist/00_quickstart`"},"781":{"id":"/data-scientist/reference/descriptor-store-9","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#column_map_versions","content":"Every saved version of a dataset's column map, oldest first: \\{version, approved_at, roles, slots, evidence} -\nwhat approving one of them again (RoleReview\\.approve) would restore."},"782":{"id":"/data-scientist/reference/descriptor-store-10","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#current_version","content":"The approved version's number from `current`, or None when there is none (or the file does not hold one)."},"783":{"id":"/data-scientist/reference/descriptor-store-11","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#descriptor_store_dir","content":"The folder that holds the versions of the descriptor `id` (whether or not it exists yet); an id that is not\na dataset id is refused, so no path is built from it."},"784":{"id":"/data-scientist/reference/descriptor-store-12","page_id":"/data-scientist/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/reference/descriptor-store#list_versions","content":"The version numbers stored for `id` (every v\\<n>.yaml), ascending; empty when none is stored."},"785":{"id":"/data-scientist/reference/docs","page_id":"/data-scientist/reference/docs","type":"page","content":"Documentation","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference/docs"},"786":{"id":"/data-scientist/reference/docs-0","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs","content":"The notebooks' documentation, opened from a cell: nb.docs()."},"787":{"id":"/data-scientist/reference/docs-1","page_id":"/data-scientist/reference/docs","type":"heading","tags":[],"url":"/data-scientist/reference/docs#Docs","content":"nb.Docs"},"788":{"id":"/data-scientist/reference/docs-2","page_id":"/data-scientist/reference/docs","type":"heading","tags":[],"url":"/data-scientist/reference/docs#docs","content":"nb.docs"},"789":{"id":"/data-scientist/reference/docs-3","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs","content":"The documentation is a site of plain files the kit ships (`notebook/docs/site` in the kit copy): pages, styles and\na search index, built ahead of time. This module serves that folder from this Python on this computer only\n(the loopback address, a free port) and shows it in a frame under the cell, so reading and searching need no internet, no Node\nand no second install. The server starts on the first call and stops with the kernel."},"790":{"id":"/data-scientist/reference/docs-4","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs","content":"A command's page is found in the site's own list (`commands.json`, written from `exakit.nb`'s `__all__` when the\nsite is built), so every public helper has one. Anything else is handed to the site's search."},"791":{"id":"/data-scientist/reference/docs-5","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#Docs","content":"What `nb.docs()` returns: the documentation at `url`. A notebook shows it in a frame under the cell;\n`open()` opens it in a browser tab."},"792":{"id":"/data-scientist/reference/docs-6","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#Docs","content":"Member"},"793":{"id":"/data-scientist/reference/docs-7","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#Docs","content":"What it is"},"794":{"id":"/data-scientist/reference/docs-8","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#Docs","content":"`open() -> Docs`"},"795":{"id":"/data-scientist/reference/docs-9","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#Docs","content":"Open the page in the default browser."},"796":{"id":"/data-scientist/reference/docs-10","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#docs","content":"Open the notebooks' documentation: all of it, one command's page, one page, or a search."},"797":{"id":"/data-scientist/reference/docs-11","page_id":"/data-scientist/reference/docs","tags":[],"type":"text","url":"/data-scientist/reference/docs#docs","content":"`what` is nothing (the section of the persona whose notebook this is, else the start page), a helper or its name (`nb.describe`, `\"describe\"`: that command's page),\na page's address (`\"concepts/descriptor\"`), or any other words (searched, typos forgiven). The result shows\nunder the cell in a frame `height` pixels tall; `browser=True` opens a browser tab too. Served from this\ncomputer only, from files the kit ships: nothing is fetched from the internet."},"798":{"id":"/data-scientist/reference/handoff-bundle","page_id":"/data-scientist/reference/handoff-bundle","type":"page","content":"Hand-off bundle","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference/handoff-bundle"},"799":{"id":"/data-scientist/reference/handoff-bundle-0","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle","content":"Hand off: everything a colleague needs to repeat a piece of work, in one folder (and one zip)."},"800":{"id":"/data-scientist/reference/handoff-bundle-1","page_id":"/data-scientist/reference/handoff-bundle","type":"heading","tags":[],"url":"/data-scientist/reference/handoff-bundle#handoff_bundle","content":"nb.handoff_bundle"},"801":{"id":"/data-scientist/reference/handoff-bundle-2","page_id":"/data-scientist/reference/handoff-bundle","type":"heading","tags":[],"url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"nb.HandoffBundle"},"802":{"id":"/data-scientist/reference/handoff-bundle-3","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle","content":"The folder holds the approved column map (`descriptor.yaml`), the schema map when there is one\n(`schema-map.json`), every query the workflow ran with its digest and row count (`queries.sql`), the workflow log\nas it is (`workflow.jsonl`) and a `README.md` that says what the data is, which column map version the numbers rest\non, which questions were approved, which dashboards were published and how to repeat it. Nothing in it is a password:\nthe log is already written without one, and the connection is the kit's."},"803":{"id":"/data-scientist/reference/handoff-bundle-4","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle","content":"This is the Data Scientist's hand-off. The ML Engineer's training handoff (one JSON file with the feature view and the\nsplit, `nb.write_handoff`) is a different thing with its own folder."},"804":{"id":"/data-scientist/reference/handoff-bundle-5","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#handoff_bundle","content":"Write the bundle for `ds` and the workflow (the active one, else the last one on this machine, else none) into\n`folder` (default `$EXAKIT_HOME/bundles/<workflow id>/`; a bundle for no workflow is named after the dataset)\nand, with `zip_it`, a zip beside it. The active workflow's log gets a `handoff` line with the path."},"805":{"id":"/data-scientist/reference/handoff-bundle-6","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#handoff_bundle","content":"**Used in:** `data-scientist/03_share`"},"806":{"id":"/data-scientist/reference/handoff-bundle-7","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"Where the bundle is and what is in it."},"807":{"id":"/data-scientist/reference/handoff-bundle-8","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"Member"},"808":{"id":"/data-scientist/reference/handoff-bundle-9","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"What it is"},"809":{"id":"/data-scientist/reference/handoff-bundle-10","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`path`"},"810":{"id":"/data-scientist/reference/handoff-bundle-11","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`Path`"},"811":{"id":"/data-scientist/reference/handoff-bundle-12","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`zip_path`"},"812":{"id":"/data-scientist/reference/handoff-bundle-13","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"\\`Path"},"813":{"id":"/data-scientist/reference/handoff-bundle-14","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"None\\`"},"814":{"id":"/data-scientist/reference/handoff-bundle-15","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`workflow_id`"},"815":{"id":"/data-scientist/reference/handoff-bundle-16","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"\\`str"},"816":{"id":"/data-scientist/reference/handoff-bundle-17","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"None\\`"},"817":{"id":"/data-scientist/reference/handoff-bundle-18","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`files`"},"818":{"id":"/data-scientist/reference/handoff-bundle-19","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`list[str]`"},"819":{"id":"/data-scientist/reference/handoff-bundle-20","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`summary`"},"820":{"id":"/data-scientist/reference/handoff-bundle-21","page_id":"/data-scientist/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/reference/handoff-bundle#HandoffBundle","content":"`list[str]`"},"821":{"id":"/data-scientist/reference/handoff","page_id":"/data-scientist/reference/handoff","type":"page","content":"Training handoff","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference/handoff"},"822":{"id":"/data-scientist/reference/handoff-0","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff","content":"The handoff from the Data Scientist to the ML Engineer (DS-3 -> ML-3, design 4): one JSON file that holds everything 01_train needs to train without opening the descriptor - which descriptor version and digest it came from, a digest of the data, the feature view built from the roles (as CREATE OR REPLACE VIEW SQL), the label and its positive class, the training SELECT with a reproducible time split, and the input and output schemas."},"823":{"id":"/data-scientist/reference/handoff-1","page_id":"/data-scientist/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/reference/handoff#handoff_from","content":"nb.handoff_from"},"824":{"id":"/data-scientist/reference/handoff-2","page_id":"/data-scientist/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/reference/handoff#handoff_is_stale","content":"nb.handoff_is_stale"},"825":{"id":"/data-scientist/reference/handoff-3","page_id":"/data-scientist/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/reference/handoff#read_handoff","content":"nb.read_handoff"},"826":{"id":"/data-scientist/reference/handoff-4","page_id":"/data-scientist/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/reference/handoff#write_handoff","content":"nb.write_handoff"},"827":{"id":"/data-scientist/reference/handoff-5","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff","content":"The handoff from the Data Scientist to the ML Engineer (DS-3 -> ML-3, design 4): one JSON file that holds everything\n`01_train` needs to train without opening the descriptor - which descriptor version and digest it came from, a digest\nof the data, the feature view built from the roles (as `CREATE OR REPLACE VIEW` SQL), the label and its positive\nclass, the training SELECT with a reproducible time split, and the input and output schemas. A descriptor without a date\nrole has no time split: the handoff is refused with the fix (`split=\"random\"` for a reproducible hash split, or a\ndate role) - a random split is never silent, and `01_train` refuses one the file does not mark as asked for."},"828":{"id":"/data-scientist/reference/handoff-6","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff","content":"The feature view is SQL only - category one-hot over the top-20 values plus OTHER, date -> year / month / ISO day of\nweek / days since the first date, text -> LENGTH, entity -> frequency - so a model that is linear over these columns can\nbe scored by Rust on the very same view (ML-5): TF-IDF stays out of it (the client-side model in explore keeps it);\ntop-k token flags computed in SQL are the deferred next step and are recorded as such in the file. The view is not\ncreated here: the ML quickstart and 01_train create it, with the admin profile."},"829":{"id":"/data-scientist/reference/handoff-7","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff","content":"The file names a table, columns, SQL and digests, never a host, a user or a password; the kit's secret-grep test\ncovers the folder. A workflow that is active gets one `handoff` line in its log (X-1)."},"830":{"id":"/data-scientist/reference/handoff-8","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#handoff_from","content":"The handoff record for `ds` as design 4 shapes it, built now and returned, nothing written: the descriptor's\nid, version, digest (`digest_kind` says whether it is the table digest or the file's) and source; the data\ndigest (`data_digest_kind`); the feature view; the label and its positive class (`label` overrides it);\nthe split (`time` over the date role by default; `split=\"random\"` for a hash split, the only way to get one -\nwithout a date role and without that, a ValueError names the fix; `split.explicit` records the choice) and\n`train_share`; the training SQL; input and output schemas. `workflow_id` defaults to the active workflow's."},"831":{"id":"/data-scientist/reference/handoff-9","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#handoff_is_stale","content":"None when `handoff` still describes `ds` and its data; else the line 01_train prints before it refuses:\nthe descriptor's version or digest changed (recomputed from `ds`: the same kind the handoff recorded), or - with\na connection - the data digest no longer matches. The fix is in the line."},"832":{"id":"/data-scientist/reference/handoff-10","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#handoff_is_stale","content":"**Used in:** `ml-engineer/02_rust_score`"},"833":{"id":"/data-scientist/reference/handoff-11","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#read_handoff","content":"The handoff as a dict: from a path to the file, from `<id>-v<n>` (that version's file), or from a descriptor\nid (the file with the highest version in the handoffs folder). None there is a FileNotFoundError saying how to\nmake one."},"834":{"id":"/data-scientist/reference/handoff-12","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#read_handoff","content":"**Used in:** `ml-engineer/02_rust_score`"},"835":{"id":"/data-scientist/reference/handoff-13","page_id":"/data-scientist/reference/handoff","tags":[],"type":"text","url":"/data-scientist/reference/handoff#write_handoff","content":"Build the handoff (handoff_from) and write it to `$EXAKIT_HOME/handoffs/<id>-v<n>.json` - the folder 0700,\nthe file 0600, replaced whole (a temporary file renamed over it) so a reader never sees half of one. The active\nworkflow's log gets a `handoff` line with the path and the descriptor's id and version. Returns the path."},"836":{"id":"/data-scientist/reference","page_id":"/data-scientist/reference","type":"page","content":"All commands","breadcrumbs":["Documentation","Data Scientist","Command reference"],"tags":[],"url":"/data-scientist/reference"},"837":{"id":"/data-scientist/reference-0","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Every public helper of exakit.nb, 111 in all, with the page that documents it."},"838":{"id":"/data-scientist/reference-1","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Every notebook starts with `import exakit.nb as nb`. Each name below is one call a cell can make, and the same\ncall a guided card makes behind its buttons."},"839":{"id":"/data-scientist/reference-2","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Command"},"840":{"id":"/data-scientist/reference-3","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"What it does"},"841":{"id":"/data-scientist/reference-4","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.addon_ready`"},"842":{"id":"/data-scientist/reference-5","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Make an add-on usable from here: install it when it is not (`exakit marketplace <addon>`), start it when it is a service and stopped (`exakit start <addon>`), and say its state and address."},"843":{"id":"/data-scientist/reference-6","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.addons`"},"844":{"id":"/data-scientist/reference-7","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The marketplace's add-ons as `exakit marketplace --list --json` reports them: \\{id, name, about, status, installed, version, url}, and `offered`: False for one the kit's catalog does not offer yet (its marketplace/catalog.json says \"visible\": false, so no marketplace screen lists it)."},"845":{"id":"/data-scientist/reference-8","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.ai_clients`"},"846":{"id":"/data-scientist/reference-9","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The AI clients the kit can connect to the database (its MCP adapters), each \\{id, name, connected}, with connected from `exakit mcp-status --json`."},"847":{"id":"/data-scientist/reference-10","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.approved_datasets`"},"848":{"id":"/data-scientist/reference-11","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Every dataset with an approved column map, newest approval first: \\{id, table, version, approved_at}."},"849":{"id":"/data-scientist/reference-12","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.ask`"},"850":{"id":"/data-scientist/reference-13","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Draft SQL from roles and the user's opted-in model endpoint; `proposed_sql` supports manual drafting."},"851":{"id":"/data-scientist/reference-14","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.check_bucket`"},"852":{"id":"/data-scientist/reference-15","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The deployment's bucket directory exists on this machine where the kit says it is, and - given a connection - a UDF sees it at its /buckets path too (skipped, with a note, when the container check fails)."},"853":{"id":"/data-scientist/reference-16","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.check_connection`"},"854":{"id":"/data-scientist/reference-17","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The database answers: its time, this session's id and its version, as one row (and one line)."},"855":{"id":"/data-scientist/reference-18","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.check_container`"},"856":{"id":"/data-scientist/reference-19","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The container behind `alias` runs a smoke UDF, and it has every package training needs."},"857":{"id":"/data-scientist/reference-20","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.check_mlflow`"},"858":{"id":"/data-scientist/reference-21","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Check the destination runs will really use: configured server, kit server, or local store."},"859":{"id":"/data-scientist/reference-22","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.check_model_compatibility`"},"860":{"id":"/data-scientist/reference-23","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Refuse a pickle whose scikit-learn version differs before any scoring SQL runs."},"861":{"id":"/data-scientist/reference-24","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.chosen_dataset`"},"862":{"id":"/data-scientist/reference-25","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The dataset a notebook works on: `name` when it is set; with None, the one approved last in a quickstart (so picking fraud_transactions there carries on here), else amazon_sales."},"863":{"id":"/data-scientist/reference-26","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.clean_path`"},"864":{"id":"/data-scientist/reference-27","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"A path pasted into a cell, made usable: quotes and spaces around it, a `file://` link, the shell's backslash escapes (`My\\ Data`, from a drag into a terminal) and `~` are undone."},"865":{"id":"/data-scientist/reference-28","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.column_map_versions`"},"866":{"id":"/data-scientist/reference-29","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Every saved version of a dataset's column map, oldest first: \\{version, approved_at, roles, slots, evidence} - what approving one of them again (RoleReview\\.approve) would restore."},"867":{"id":"/data-scientist/reference-30","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.components`"},"868":{"id":"/data-scientist/reference-31","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The kit's parts as `exakit version --json` reports them: \\{id, installed, available, status, add_on, ownership, remedy}, with a status of current, ahead, update_available, available (an add-on not installed) or missing; `available` is the version the kit would install or update to."},"869":{"id":"/data-scientist/reference-32","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.confirm_send`"},"870":{"id":"/data-scientist/reference-33","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Before sampled rows go to a model endpoint: True at once for a table in the database; for a live source (the descriptor names a source) it names the source and asks, and only a yes sends."},"871":{"id":"/data-scientist/reference-34","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.connect`"},"872":{"id":"/data-scientist/reference-35","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"A pyexasol connection to the local database, opened from the kit's encrypted store, pinned to the database's TLS certificate once the kit has recorded it."},"873":{"id":"/data-scientist/reference-36","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.connect_source`"},"874":{"id":"/data-scientist/reference-37","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Connect an external source as a virtual schema, from a notebook cell."},"875":{"id":"/data-scientist/reference-38","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.connected_sources`"},"876":{"id":"/data-scientist/reference-39","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The virtual schemas in the database (external sources) with their number of tables; empty when there is none."},"877":{"id":"/data-scientist/reference-40","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.connector_inputs`"},"878":{"id":"/data-scientist/reference-41","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"What `exakit connect <connector>` asks, from the kit's source engine (`inputs`: what its connect form reads, in the form's order)."},"879":{"id":"/data-scientist/reference-42","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.connectors`"},"880":{"id":"/data-scientist/reference-43","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The kinds of external source `exakit connect` takes, as its own menu lists them (the kit's source engine, `catalog`): \\{id, name, summary, aliases, tier, status, version, gate} - `version` the adapter the kit pins, `gate` why one is not available yet (empty when it is)."},"881":{"id":"/data-scientist/reference-44","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.continue_workflow`"},"882":{"id":"/data-scientist/reference-45","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The workflow already going, without an id to paste: this kernel's, else the one inherited through EXAKIT_WORKFLOW_ID, else the last one started or resumed on this machine (a quickstart starts one); a new one named `name` only when there is none."},"883":{"id":"/data-scientist/reference-46","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.count_name`"},"884":{"id":"/data-scientist/reference-47","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The count column, named after what is counted: ORDER_LINES, STORE_WEEKS; ROW_COUNT when the descriptor does not say (ROWS is an SQL word)."},"885":{"id":"/data-scientist/reference-48","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.current_version`"},"886":{"id":"/data-scientist/reference-49","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The approved version's number from `current`, or None when there is none (or the file does not hold one)."},"887":{"id":"/data-scientist/reference-50","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.current_workflow`"},"888":{"id":"/data-scientist/reference-51","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The active workflow id: the session's, else the one inherited through EXAKIT_WORKFLOW_ID, else None."},"889":{"id":"/data-scientist/reference-52","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.dash_tools`"},"890":{"id":"/data-scientist/reference-53","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The notebook's Dash Server tool adapter; each call is an MCP tool call."},"891":{"id":"/data-scientist/reference-54","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.DashTools`"},"892":{"id":"/data-scientist/reference-55","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Synchronous adapter for notebook cells, which already run an event loop."},"893":{"id":"/data-scientist/reference-56","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.data_checks`"},"894":{"id":"/data-scientist/reference-57","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"Prepare: one row per finding - CHECK, COLUMN_NAME, ROWS_AFFECTED, PCT, MEANS - for repeated keys, repeated identifiers, exact copies of a row, empty cells, placeholder values and a rare label."},"895":{"id":"/data-scientist/reference-58","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.data_map`"},"896":{"id":"/data-scientist/reference-59","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"The semantic map of the database: every table by origin (sample, local, source) with its rows, columns, column-map state and roles, then the links between tables - declared, found by an approved schema map, or a shared key-like column name across two tables (marked possible)."},"897":{"id":"/data-scientist/reference-60","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.DataMap`"},"898":{"id":"/data-scientist/reference-61","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"What data_map found: tables, columns and links, each a list of dicts; DataFrames through the properties."},"899":{"id":"/data-scientist/reference-62","page_id":"/data-scientist/reference","tags":[],"type":"text","url":"/data-scientist/reference","content":"`nb.Dataset`"},"900":{"id":"/data-scientist/reference-63","page_id"