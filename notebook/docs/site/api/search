e","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"The role review's correction: `role` (one of the five) to `column`, or empty with `reason`."},"3518":{"id":"/data-scientist/development/reference/describe-31","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`copy() -> Draft`"},"3519":{"id":"/data-scientist/development/reference/describe-32","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`to_dict() -> dict[str, Any]`"},"3520":{"id":"/data-scientist/development/reference/describe-33","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"The descriptor document (a copy)."},"3521":{"id":"/data-scientist/development/reference/describe-34","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`to_yaml() -> str`"},"3522":{"id":"/data-scientist/development/reference/describe-35","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`save(path: str \\| Path) -> Path`"},"3523":{"id":"/data-scientist/development/reference/describe-36","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"Write the descriptor as YAML; exakit_nb.dataset(conn, path) reads it back."},"3524":{"id":"/data-scientist/development/reference/describe-37","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`approve(owner: str \\| None=None, comments: bool=True, *, conn=None, sample: int \\| None=None)`"},"3525":{"id":"/data-scientist/development/reference/describe-38","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"Approve: every column has a role and none sits in two slots, the table has not changed since it was profiled, the next version is written into the kit's store with current.yaml, and the schema's Exasol Semantic Views model is rebuilt with it (`comments=False` skips that)."},"3526":{"id":"/data-scientist/development/reference/describe-39","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`rows() -> list[dict[str, str]]`"},"3527":{"id":"/data-scientist/development/reference/describe-40","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"One dict per column, low confidence first: the schema and table it came from, its name, type, role, confidence, evidence and note."},"3528":{"id":"/data-scientist/development/reference/describe-41","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"`show() -> None`"},"3529":{"id":"/data-scientist/development/reference/describe-42","page_id":"/data-scientist/development/reference/describe","tags":[],"type":"text","url":"/data-scientist/development/reference/describe#Draft","content":"Print each column with its schema and table, type, role, confidence, evidence and note, low confidence first, the slots above."},"3530":{"id":"/data-scientist/development/reference/descriptor-store","page_id":"/data-scientist/development/reference/descriptor-store","type":"page","content":"Approved column maps","breadcrumbs":["Documentation","Data Scientist","Development","Notebook commands"],"tags":[],"url":"/data-scientist/development/reference/descriptor-store"},"3531":{"id":"/data-scientist/development/reference/descriptor-store-0","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store","content":"Where a user's approved descriptors live."},"3532":{"id":"/data-scientist/development/reference/descriptor-store-1","page_id":"/data-scientist/development/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/development/reference/descriptor-store#approved_datasets","content":"nb.approved_datasets"},"3533":{"id":"/data-scientist/development/reference/descriptor-store-2","page_id":"/data-scientist/development/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/development/reference/descriptor-store#column_map_versions","content":"nb.column_map_versions"},"3534":{"id":"/data-scientist/development/reference/descriptor-store-3","page_id":"/data-scientist/development/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/development/reference/descriptor-store#current_version","content":"nb.current_version"},"3535":{"id":"/data-scientist/development/reference/descriptor-store-4","page_id":"/data-scientist/development/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/development/reference/descriptor-store#descriptor_store_dir","content":"nb.descriptor_store_dir"},"3536":{"id":"/data-scientist/development/reference/descriptor-store-5","page_id":"/data-scientist/development/reference/descriptor-store","type":"heading","tags":[],"url":"/data-scientist/development/reference/descriptor-store#list_versions","content":"nb.list_versions"},"3537":{"id":"/data-scientist/development/reference/descriptor-store-6","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store","content":"Where a user's approved descriptors live. Today: `~/.exasol-starter-kit/descriptors/<SCHEMA>.<TABLE>/current.yaml`\n(setup/lib/descriptor/store.py writes it; table_descriptor() finds it by its dataset id). Before that, and still read:\n`~/.exasol-starter-kit/descriptors/<id>/` (the kit's home, EXAKIT_HOME\nwhen set) holds one `v<n>.yaml` per version and `current`, a text file with the number of the approved version.\nRead-only here: `exakit describe <id> --approve` and `Draft.approve()` write versions; `Dataset` reads the\ncurrent one before it falls back to a shipped descriptor."},"3538":{"id":"/data-scientist/development/reference/descriptor-store-7","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#approved_datasets","content":"Every dataset with an approved column map, newest approval first: \\{id, table, version, approved_at}."},"3539":{"id":"/data-scientist/development/reference/descriptor-store-8","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#approved_datasets","content":"**Used in:** `data-scientist/00_quickstart`"},"3540":{"id":"/data-scientist/development/reference/descriptor-store-9","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#column_map_versions","content":"Every saved version of a dataset's column map, oldest first: \\{version, approved_at, roles, slots, evidence} -\nwhat approving one of them again (RoleReview\\.approve) would restore."},"3541":{"id":"/data-scientist/development/reference/descriptor-store-10","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#current_version","content":"The approved version's number from `current`, or None when there is none (or the file does not hold one)."},"3542":{"id":"/data-scientist/development/reference/descriptor-store-11","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#descriptor_store_dir","content":"The folder that holds the versions of the descriptor `id` (whether or not it exists yet); an id that is not\na dataset id is refused, so no path is built from it."},"3543":{"id":"/data-scientist/development/reference/descriptor-store-12","page_id":"/data-scientist/development/reference/descriptor-store","tags":[],"type":"text","url":"/data-scientist/development/reference/descriptor-store#list_versions","content":"The version numbers stored for `id` (every v\\<n>.yaml), ascending; empty when none is stored."},"3544":{"id":"/data-scientist/development/reference/docs","page_id":"/data-scientist/development/reference/docs","type":"page","content":"Documentation","breadcrumbs":["Documentation","Data Scientist","Development","Notebook commands"],"tags":[],"url":"/data-scientist/development/reference/docs"},"3545":{"id":"/data-scientist/development/reference/docs-0","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs","content":"The notebooks' documentation, opened from a cell: nb.docs()."},"3546":{"id":"/data-scientist/development/reference/docs-1","page_id":"/data-scientist/development/reference/docs","type":"heading","tags":[],"url":"/data-scientist/development/reference/docs#Docs","content":"nb.Docs"},"3547":{"id":"/data-scientist/development/reference/docs-2","page_id":"/data-scientist/development/reference/docs","type":"heading","tags":[],"url":"/data-scientist/development/reference/docs#docs","content":"nb.docs"},"3548":{"id":"/data-scientist/development/reference/docs-3","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs","content":"The documentation is a site of plain files the kit ships (`notebook/docs/site` in the kit copy): pages, styles and\na search index, built ahead of time. This module serves that folder from this Python on this computer only\n(the loopback address, a free port) and shows it in a frame under the cell, so reading and searching need no internet, no Node\nand no second install. The server starts on the first call and stops with the kernel."},"3549":{"id":"/data-scientist/development/reference/docs-4","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs","content":"A command's page is found in the site's own list (`commands.json`, written from `exakit.nb`'s `__all__` when the\nsite is built), so every public helper has one. Anything else is handed to the site's search."},"3550":{"id":"/data-scientist/development/reference/docs-5","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#Docs","content":"What `nb.docs()` returns: the documentation at `url`. A notebook shows it in a frame under the cell;\n`open()` opens it in a browser tab."},"3551":{"id":"/data-scientist/development/reference/docs-6","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#Docs","content":"Member"},"3552":{"id":"/data-scientist/development/reference/docs-7","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#Docs","content":"What it is"},"3553":{"id":"/data-scientist/development/reference/docs-8","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#Docs","content":"`open() -> Docs`"},"3554":{"id":"/data-scientist/development/reference/docs-9","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#Docs","content":"Open the page in the default browser."},"3555":{"id":"/data-scientist/development/reference/docs-10","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#docs","content":"Open the notebooks' documentation: all of it, one command's page, one page, or a search."},"3556":{"id":"/data-scientist/development/reference/docs-11","page_id":"/data-scientist/development/reference/docs","tags":[],"type":"text","url":"/data-scientist/development/reference/docs#docs","content":"`what` is nothing (the section of the persona whose notebook this is, else the start page), a helper or its name (`nb.describe`, `\"describe\"`: that command's page),\na page's address (`\"explore\"`, `\"set-up/ai-and-langfuse\"`), or any other words (searched, typos forgiven). The result shows\nunder the cell in a frame `height` pixels tall; `browser=True` opens a browser tab too. Served from this\ncomputer only, from files the kit ships: nothing is fetched from the internet."},"3557":{"id":"/data-scientist/development/reference/handoff-bundle","page_id":"/data-scientist/development/reference/handoff-bundle","type":"page","content":"Hand-off bundle","breadcrumbs":["Documentation","Data Scientist","Development","Notebook commands"],"tags":[],"url":"/data-scientist/development/reference/handoff-bundle"},"3558":{"id":"/data-scientist/development/reference/handoff-bundle-0","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle","content":"Hand off: everything a colleague needs to repeat a piece of work, in one folder (and one zip)."},"3559":{"id":"/data-scientist/development/reference/handoff-bundle-1","page_id":"/data-scientist/development/reference/handoff-bundle","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff-bundle#handoff_bundle","content":"nb.handoff_bundle"},"3560":{"id":"/data-scientist/development/reference/handoff-bundle-2","page_id":"/data-scientist/development/reference/handoff-bundle","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"nb.HandoffBundle"},"3561":{"id":"/data-scientist/development/reference/handoff-bundle-3","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle","content":"The folder holds the approved column map (`descriptor.yaml`), the schema map when there is one\n(`schema-map.json`), every query the workflow ran with its digest and row count (`queries.sql`), the workflow log\nas it is (`workflow.jsonl`) and a `README.md` that says what the data is, which column map version the numbers rest\non, which questions were approved, which dashboards were published and how to repeat it. Nothing in it is a password:\nthe log is already written without one, and the connection is the kit's."},"3562":{"id":"/data-scientist/development/reference/handoff-bundle-4","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle","content":"This is the Data Scientist's hand-off. The ML Engineer's training handoff (one JSON file with the feature view and the\nsplit, `nb.write_handoff`) is a different thing with its own folder."},"3563":{"id":"/data-scientist/development/reference/handoff-bundle-5","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#handoff_bundle","content":"Write the bundle for `ds` and the workflow (the active one, else the last one on this machine, else none) into\n`folder` (default `$EXAKIT_HOME/bundles/<workflow id>/`; a bundle for no workflow is named after the dataset)\nand, with `zip_it`, a zip beside it. The active workflow's log gets a `handoff` line with the path."},"3564":{"id":"/data-scientist/development/reference/handoff-bundle-6","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#handoff_bundle","content":"**Used in:** `data-scientist/03_share`"},"3565":{"id":"/data-scientist/development/reference/handoff-bundle-7","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"Where the bundle is and what is in it."},"3566":{"id":"/data-scientist/development/reference/handoff-bundle-8","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"Member"},"3567":{"id":"/data-scientist/development/reference/handoff-bundle-9","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"What it is"},"3568":{"id":"/data-scientist/development/reference/handoff-bundle-10","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`path`"},"3569":{"id":"/data-scientist/development/reference/handoff-bundle-11","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`Path`"},"3570":{"id":"/data-scientist/development/reference/handoff-bundle-12","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`zip_path`"},"3571":{"id":"/data-scientist/development/reference/handoff-bundle-13","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"\\`Path"},"3572":{"id":"/data-scientist/development/reference/handoff-bundle-14","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"None\\`"},"3573":{"id":"/data-scientist/development/reference/handoff-bundle-15","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`workflow_id`"},"3574":{"id":"/data-scientist/development/reference/handoff-bundle-16","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"\\`str"},"3575":{"id":"/data-scientist/development/reference/handoff-bundle-17","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"None\\`"},"3576":{"id":"/data-scientist/development/reference/handoff-bundle-18","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`files`"},"3577":{"id":"/data-scientist/development/reference/handoff-bundle-19","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`list[str]`"},"3578":{"id":"/data-scientist/development/reference/handoff-bundle-20","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`summary`"},"3579":{"id":"/data-scientist/development/reference/handoff-bundle-21","page_id":"/data-scientist/development/reference/handoff-bundle","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff-bundle#HandoffBundle","content":"`list[str]`"},"3580":{"id":"/data-scientist/development/reference/handoff","page_id":"/data-scientist/development/reference/handoff","type":"page","content":"Training handoff","breadcrumbs":["Documentation","Data Scientist","Development","Notebook commands"],"tags":[],"url":"/data-scientist/development/reference/handoff"},"3581":{"id":"/data-scientist/development/reference/handoff-0","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff","content":"The handoff from the Data Scientist to the ML Engineer (DS-3 -> ML-3, design 4): one JSON file that holds everything 01_train needs to train without opening the descriptor - which descriptor version and digest it came from, a digest of the data, the feature view built from the roles (as CREATE OR REPLACE VIEW SQL), the label and its positive class, the training SELECT with a reproducible time split, and the input and output schemas."},"3582":{"id":"/data-scientist/development/reference/handoff-1","page_id":"/data-scientist/development/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff#handoff_from","content":"nb.handoff_from"},"3583":{"id":"/data-scientist/development/reference/handoff-2","page_id":"/data-scientist/development/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff#handoff_is_stale","content":"nb.handoff_is_stale"},"3584":{"id":"/data-scientist/development/reference/handoff-3","page_id":"/data-scientist/development/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff#read_handoff","content":"nb.read_handoff"},"3585":{"id":"/data-scientist/development/reference/handoff-4","page_id":"/data-scientist/development/reference/handoff","type":"heading","tags":[],"url":"/data-scientist/development/reference/handoff#write_handoff","content":"nb.write_handoff"},"3586":{"id":"/data-scientist/development/reference/handoff-5","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff","content":"The handoff from the Data Scientist to the ML Engineer (DS-3 -> ML-3, design 4): one JSON file that holds everything\n`01_train` needs to train without opening the descriptor - which descriptor version and digest it came from, a digest\nof the data, the feature view built from the roles (as `CREATE OR REPLACE VIEW` SQL), the label and its positive\nclass, the training SELECT with a reproducible time split, and the input and output schemas. A descriptor without a date\nrole has no time split: the handoff is refused with the fix (`split=\"random\"` for a reproducible hash split, or a\ndate role) - a random split is never silent, and `01_train` refuses one the file does not mark as asked for."},"3587":{"id":"/data-scientist/development/reference/handoff-6","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff","content":"The feature view is SQL only - category one-hot over the top-20 values plus OTHER, date -> year / month / ISO day of\nweek / days since the first date, text -> LENGTH, entity -> frequency - so a model that is linear over these columns can\nbe scored by Rust on the very same view (ML-5): TF-IDF stays out of it (the client-side model in explore keeps it);\ntop-k token flags computed in SQL are the deferred next step and are recorded as such in the file. The view is not\ncreated here: the ML quickstart and 01_train create it, with the admin profile."},"3588":{"id":"/data-scientist/development/reference/handoff-7","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff","content":"The file names a table, columns, SQL and digests, never a host, a user or a password; the kit's secret-grep test\ncovers the folder. A workflow that is active gets one `handoff` line in its log (X-1)."},"3589":{"id":"/data-scientist/development/reference/handoff-8","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#handoff_from","content":"The handoff record for `ds` as design 4 shapes it, built now and returned, nothing written: the descriptor's\nid, version, digest (`digest_kind` says whether it is the table digest or the file's) and source; the data\ndigest (`data_digest_kind`); the feature view; the label and its positive class (`label` overrides it);\nthe split (`time` over the date role by default; `split=\"random\"` for a hash split, the only way to get one -\nwithout a date role and without that, a ValueError names the fix; `split.explicit` records the choice) and\n`train_share`; the training SQL; input and output schemas. `workflow_id` defaults to the active workflow's."},"3590":{"id":"/data-scientist/development/reference/handoff-9","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#handoff_is_stale","content":"None when `handoff` still describes `ds` and its data; else the line 01_train prints before it refuses:\nthe descriptor's version or digest changed (recomputed from `ds`: the same kind the handoff recorded), or - with\na connection - the data digest no longer matches. The fix is in the line."},"3591":{"id":"/data-scientist/development/reference/handoff-10","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#handoff_is_stale","content":"**Used in:** `ml-engineer/02_rust_score`"},"3592":{"id":"/data-scientist/development/reference/handoff-11","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#read_handoff","content":"The handoff as a dict: from a path to the file, from `<id>-v<n>` (that version's file), or from a descriptor\nid (the file with the highest version in the handoffs folder). None there is a FileNotFoundError saying how to\nmake one."},"3593":{"id":"/data-scientist/development/reference/handoff-12","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#read_handoff","content":"**Used in:** `ml-engineer/02_rust_score`"},"3594":{"id":"/data-scientist/development/reference/handoff-13","page_id":"/data-scientist/development/reference/handoff","tags":[],"type":"text","url":"/data-scientist/development/reference/handoff#write_handoff","content":"Build the handoff (handoff_from) and write it to `$EXAKIT_HOME/handoffs/<id>-v<n>.json` - the folder 0700,\nthe file 0600, replaced whole (a temporary file renamed over it) so a reader never sees half of one. The active\nworkflow's log gets a `handoff` line with the path and the descriptor's id and version. Returns the path."},"3595":{"id":"/data-scientist/development/reference","page_id":"/data-scientist/development/reference","type":"page","content":"All commands","breadcrumbs":["Documentation","Data Scientist","Development","Notebook commands"],"tags":[],"url":"/data-scientist/development/reference"},"3596":{"id":"/data-scientist/development/reference-0","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Every public helper of exakit.nb, 120 in all, with the page that documents it."},"3597":{"id":"/data-scientist/development/reference-1","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Every notebook starts with `import exakit.nb as nb`. Each name below is one call a cell can make, and the same\ncall a guided card makes behind its buttons."},"3598":{"id":"/data-scientist/development/reference-2","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Command"},"3599":{"id":"/data-scientist/development/reference-3","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"What it does"},"3600":{"id":"/data-scientist/development/reference-4","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.addon_ready`"},"3601":{"id":"/data-scientist/development/reference-5","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Make an add-on usable from here: install it when it is not (`exakit marketplace <addon>`), start it when it is a service and stopped (`exakit start <addon>`), and say its state and address."},"3602":{"id":"/data-scientist/development/reference-6","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.addons`"},"3603":{"id":"/data-scientist/development/reference-7","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The marketplace's add-ons as `exakit marketplace --list --json` reports them: \\{id, name, about, status, installed, version, url}, and `offered`: False for one the kit's catalog does not offer yet (its marketplace/catalog.json says \"visible\": false, so no marketplace screen lists it)."},"3604":{"id":"/data-scientist/development/reference-8","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.ai_clients`"},"3605":{"id":"/data-scientist/development/reference-9","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The AI clients the kit can connect to the database (its MCP adapters), each \\{id, name, connected}, with connected from `exakit mcp-status --json`."},"3606":{"id":"/data-scientist/development/reference-10","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.approved_datasets`"},"3607":{"id":"/data-scientist/development/reference-11","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Every dataset with an approved column map, newest approval first: \\{id, table, version, approved_at}."},"3608":{"id":"/data-scientist/development/reference-12","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.ask`"},"3609":{"id":"/data-scientist/development/reference-13","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Draft SQL from the user's opted-in model endpoint; `proposed_sql` supports manual drafting."},"3610":{"id":"/data-scientist/development/reference-14","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.check_bucket`"},"3611":{"id":"/data-scientist/development/reference-15","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The deployment's bucket directory exists on this machine where the kit says it is, and - given a connection - a UDF sees it at its /buckets path too (skipped, with a note, when the container check fails)."},"3612":{"id":"/data-scientist/development/reference-16","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.check_connection`"},"3613":{"id":"/data-scientist/development/reference-17","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The database answers: its time, this session's id and its version, as one row (and one line)."},"3614":{"id":"/data-scientist/development/reference-18","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.check_container`"},"3615":{"id":"/data-scientist/development/reference-19","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The container behind `alias` runs a smoke UDF, and it has every package training needs."},"3616":{"id":"/data-scientist/development/reference-20","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.check_mlflow`"},"3617":{"id":"/data-scientist/development/reference-21","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Check the destination runs will really use: configured server, kit server, or local store."},"3618":{"id":"/data-scientist/development/reference-22","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.check_model_compatibility`"},"3619":{"id":"/data-scientist/development/reference-23","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Refuse a pickle whose scikit-learn version differs before any scoring SQL runs."},"3620":{"id":"/data-scientist/development/reference-24","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.chosen_dataset`"},"3621":{"id":"/data-scientist/development/reference-25","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The dataset a notebook works on: `name` when it is set; with None, the one approved last in a quickstart (so picking fraud_transactions there carries on here), else amazon_sales."},"3622":{"id":"/data-scientist/development/reference-26","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.clean_path`"},"3623":{"id":"/data-scientist/development/reference-27","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"A path pasted into a cell, made usable: quotes and spaces around it, a `file://` link, the shell's backslash escapes (`My\\ Data`, from a drag into a terminal) and `~` are undone."},"3624":{"id":"/data-scientist/development/reference-28","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.column_map_versions`"},"3625":{"id":"/data-scientist/development/reference-29","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Every saved version of a dataset's column map, oldest first: \\{version, approved_at, roles, slots, evidence} - what approving one of them again (RoleReview\\.approve) would restore."},"3626":{"id":"/data-scientist/development/reference-30","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.components`"},"3627":{"id":"/data-scientist/development/reference-31","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The kit's parts as `exakit version --json` reports them: \\{id, installed, available, status, add_on, ownership, remedy}, with a status of current, ahead, update_available, available (an add-on not installed) or missing; `available` is the version the kit would install or update to."},"3628":{"id":"/data-scientist/development/reference-32","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.confirm_send`"},"3629":{"id":"/data-scientist/development/reference-33","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Before sampled rows go to a model endpoint: True at once for a table in the database; for a live source (the descriptor names a source) it names the source and asks, and only a yes sends."},"3630":{"id":"/data-scientist/development/reference-34","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.connect`"},"3631":{"id":"/data-scientist/development/reference-35","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"A pyexasol connection to the local database, opened from the kit's encrypted store, pinned to the database's TLS certificate once the kit has recorded it."},"3632":{"id":"/data-scientist/development/reference-36","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.connect_source`"},"3633":{"id":"/data-scientist/development/reference-37","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Connect an external source as a virtual schema, from a notebook cell."},"3634":{"id":"/data-scientist/development/reference-38","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.connected_sources`"},"3635":{"id":"/data-scientist/development/reference-39","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The virtual schemas in the database (external sources) with their number of tables; empty when there is none."},"3636":{"id":"/data-scientist/development/reference-40","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.connector_inputs`"},"3637":{"id":"/data-scientist/development/reference-41","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"What `exakit connect <connector>` asks, from the kit's source engine (`inputs`: what its connect form reads, in the form's order)."},"3638":{"id":"/data-scientist/development/reference-42","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.connectors`"},"3639":{"id":"/data-scientist/development/reference-43","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The kinds of external source `exakit connect` takes, as its own menu lists them (the kit's source engine, `catalog`): \\{id, name, summary, aliases, tier, status, version, gate} - `version` the adapter the kit pins, `gate` why one is not available yet (empty when it is)."},"3640":{"id":"/data-scientist/development/reference-44","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.continue_workflow`"},"3641":{"id":"/data-scientist/development/reference-45","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The workflow already going, without an id to paste: this kernel's, else the one inherited through EXAKIT_WORKFLOW_ID, else the last one started or resumed on this machine (a quickstart starts one); a new one named `name` only when there is none."},"3642":{"id":"/data-scientist/development/reference-46","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.count_name`"},"3643":{"id":"/data-scientist/development/reference-47","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The count column, named after what is counted: ORDER_LINES, STORE_WEEKS; ROW_COUNT when the descriptor does not say (ROWS is an SQL word)."},"3644":{"id":"/data-scientist/development/reference-48","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.current_version`"},"3645":{"id":"/data-scientist/development/reference-49","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The approved version's number from `current`, or None when there is none (or the file does not hold one)."},"3646":{"id":"/data-scientist/development/reference-50","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.current_workflow`"},"3647":{"id":"/data-scientist/development/reference-51","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The active workflow id: the session's, else the one inherited through EXAKIT_WORKFLOW_ID, else None."},"3648":{"id":"/data-scientist/development/reference-52","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.dash_tools`"},"3649":{"id":"/data-scientist/development/reference-53","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The notebook's Dash Server tool adapter; each call is an MCP tool call."},"3650":{"id":"/data-scientist/development/reference-54","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.DashTools`"},"3651":{"id":"/data-scientist/development/reference-55","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Synchronous adapter for notebook cells, which already run an event loop."},"3652":{"id":"/data-scientist/development/reference-56","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.data_checks`"},"3653":{"id":"/data-scientist/development/reference-57","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Prepare: one row per finding - CHECK, COLUMN_NAME, ROWS_AFFECTED, PCT, MEANS - for repeated keys, repeated identifiers, exact copies of a row, empty cells, placeholder values and a rare label."},"3654":{"id":"/data-scientist/development/reference-58","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.data_map`"},"3655":{"id":"/data-scientist/development/reference-59","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The semantic map of the database: every table by origin (sample, local, source) with its rows, columns, column-map state and roles, then the links between tables - declared, found by an approved schema map, or a shared key-like column name across two tables (marked possible)."},"3656":{"id":"/data-scientist/development/reference-60","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.DataMap`"},"3657":{"id":"/data-scientist/development/reference-61","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"What data_map found: tables, columns and links, each a list of dicts; DataFrames through the properties."},"3658":{"id":"/data-scientist/development/reference-62","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.Dataset`"},"3659":{"id":"/data-scientist/development/reference-63","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"A validated descriptor whose every role the database holds, with the SQL names the notebooks build queries from."},"3660":{"id":"/data-scientist/development/reference-64","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.dataset`"},"3661":{"id":"/data-scientist/development/reference-65","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The dataset `name`, checked against the database: a kit dataset id, a descriptor file or its folder, or a data file of your own (CSV, Parquet or JSON) with its descriptor beside it, which is loaded first (load_own_file)."},"3662":{"id":"/data-scientist/development/reference-66","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.describe`"},"3663":{"id":"/data-scientist/development/reference-67","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"Describe `SCHEMA.TABLE` (or a dataset id's table): the approved descriptor when the table still matches it, else a fresh draft."},"3664":{"id":"/data-scientist/development/reference-68","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.describe_schema`"},"3665":{"id":"/data-scientist/development/reference-69","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The schema of `dataset_or_schema` (a dataset, or a schema name) as found now: its tables, rows and keys, and every many-to-one link between them with its evidence."},"3666":{"id":"/data-scientist/development/reference-70","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.descriptor_store_dir`"},"3667":{"id":"/data-scientist/development/reference-71","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"The folder that holds the versions of the descriptor `id` (whether or not it exists yet); an id that is not a dataset id is refused, so no path is built from it."},"3668":{"id":"/data-scientist/development/reference-72","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.DescriptorNotApproved`"},"3669":{"id":"/data-scientist/development/reference-73","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"A step that needs an approved descriptor was given a draft; the message says how to approve it."},"3670":{"id":"/data-scientist/development/reference-74","page_id":"/data-scientist/development/reference","tags":[],"type":"text","url":"/data-scientist/development/reference","content":"`nb.Docs`"},"3671":{"id":"/data-scientist/development/reference-75","page_id":"/data-scientist/de