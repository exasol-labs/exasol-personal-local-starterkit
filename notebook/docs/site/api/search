ides/run-the-kit-7","page_id":"/data-scientist/guides/run-the-kit","tags":[],"type":"text","url":"/data-scientist/guides/run-the-kit#reference","content":"Kit commands, Kit facts."},"507":{"id":"/data-scientist/guides/set-up-a-model","page_id":"/data-scientist/guides/set-up-a-model","type":"page","content":"Set up a model","breadcrumbs":["Documentation","Data Scientist","How-to guides"],"tags":[],"url":"/data-scientist/guides/set-up-a-model"},"508":{"id":"/data-scientist/guides/set-up-a-model-0","page_id":"/data-scientist/guides/set-up-a-model","tags":[],"type":"text","url":"/data-scientist/guides/set-up-a-model","content":"Point the notebooks at your AI model and, optionally, at Langfuse for tracing."},"509":{"id":"/data-scientist/guides/set-up-a-model-1","page_id":"/data-scientist/guides/set-up-a-model","type":"heading","tags":[],"url":"/data-scientist/guides/set-up-a-model#the-quickest-way","content":"The quickest way"},"510":{"id":"/data-scientist/guides/set-up-a-model-2","page_id":"/data-scientist/guides/set-up-a-model","type":"heading","tags":[],"url":"/data-scientist/guides/set-up-a-model#in-a-cell","content":"In a cell"},"511":{"id":"/data-scientist/guides/set-up-a-model-3","page_id":"/data-scientist/guides/set-up-a-model","type":"heading","tags":[],"url":"/data-scientist/guides/set-up-a-model#check-and-forget","content":"Check and forget"},"512":{"id":"/data-scientist/guides/set-up-a-model-4","page_id":"/data-scientist/guides/set-up-a-model","type":"heading","tags":[],"url":"/data-scientist/guides/set-up-a-model#the-settings-behind-it","content":"The settings behind it"},"513":{"id":"/data-scientist/guides/set-up-a-model-5","page_id":"/data-scientist/guides/set-up-a-model","type":"heading","tags":[],"url":"/data-scientist/guides/set-up-a-model#what-you-get-at-the-end","content":"What you get at the end"},"514":{"id":"/data-scientist/guides/set-up-a-model-6","page_id":"/data-scientist/guides/set-up-a-model","tags":[],"type":"text","url":"/data-scientist/guid